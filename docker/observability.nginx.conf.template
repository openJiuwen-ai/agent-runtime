# =====================================================================
# Observability nginx 配置模板
#
# 由 nginx 官方镜像 entrypoint 在启动时 envsubst 渲染:
#   /etc/nginx/templates/default.conf.template → /etc/nginx/conf.d/default.conf
# 环境变量与 observability.template.yaml 注入的同名 env 一致(必须全部提供):
#   OBSERVABILITY_PORT / OBSERVABILITY_LOKI_URL
#
# 语义对齐原 jiuwenclaw-observability(FastAPI)形态:
#   /loki/{tail}          → ${LOKI_URL}/{tail}        (原样透传, Loki API 自带 /loki 前缀)
#   /                     → web/dist 静态文件
# 已知差异: /api/audit/rules(规则 CRUD, 原 Python 后端)不提供 → 404,
#   审计规则页签会显示接口错误; agentserver 检测器走内置规则, 不受影响。
# =====================================================================

server {
    listen ${OBSERVABILITY_PORT};
    server_name _;

    root /app/agent-runtime/applications/observability/web/dist;
    index index.html;

    # 中继语义: 响应原文透传, 出口压缩交给后端协商结果
    proxy_set_header Accept-Encoding "";
    proxy_http_version 1.1;
    proxy_connect_timeout 10s;
    proxy_send_timeout 60s;
    proxy_read_timeout 60s;
    proxy_set_header Host $proxy_host;

    # ---- Loki(Loki API 前缀即 /loki, 原样透传, 不改写路径) ----
    # 部署顺序保证 loki Service 先于本模块创建; proxy_pass 为启动时解析,
    # loki 未就绪会导致本容器启动失败并由 kubelet 重试。
    location /loki/ {
        proxy_pass ${OBSERVABILITY_LOKI_URL};
    }

    # ---- 规则 CRUD 无 Python 后端, 显式 404(前端规则页签会提示错误) ----
    location /api/audit/ {
        return 404;
    }

    # index.html 可缓存但须校验(未发版刷新走 304); /assets/ 带 hash 长期缓存
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
