ARG BASE_IMAGE
ARG IMAGE_VERSION
FROM ${BASE_IMAGE}:${IMAGE_VERSION}

ARG PIP_EXTRA_ARGS="-i https://mirrors.aliyun.com/pypi/simple/"


# manager-server 启动会 import openjiuwen_runtime.service.bootstrap（多副本选主 Redis）。
# manager_server 的 pyproject 目前只声明 foundation，不装 service 则运行期
# ModuleNotFoundError: No module named 'openjiuwen_runtime.service'。
RUN uv pip install --system \
    -e "./foundation" \
    -e "./service" \
    -e "./applications/manager/manager_server" \
    ${PIP_EXTRA_ARGS}

USER app
WORKDIR /app/agent-runtime
ENV PATH=$PATH:/home/app/.local/bin

EXPOSE 8765 8766
CMD ["manager-server"]
