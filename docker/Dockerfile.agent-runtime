ARG BASE_IMAGE
FROM ${BASE_IMAGE}

ARG PIP_EXTRA_ARGS

RUN useradd --create-home --shell /bin/bash app

WORKDIR /app/agent-runtime
COPY . /app/agent-runtime/
RUN chown -R app:app /app/agent-runtime

RUN pip install -e "./foundation" \
    -e "./service" \
    -e "./applications/agent_runtime[server]" \
    --no-cache-dir \
    ${PIP_EXTRA_ARGS}

USER app
WORKDIR /app/agent-runtime
ENV PATH=$PATH:/home/app/.local/bin \
    PYTHONUNBUFFERED=1

EXPOSE 8091
CMD ["agent-runtime", "--mode", "server"]
