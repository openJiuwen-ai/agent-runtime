ARG NODE_IMAGE=node:22-alpine
# nginx 非 root 变体:关键目录属主 101:0(g+w),pid/temp 路径位于 /tmp
ARG NGINX_IMAGE=nginxinc/nginx-unprivileged:1.27-alpine

# ---------- 阶段1:前端构建 ----------
FROM ${NODE_IMAGE} AS web-builder

ARG NPM_REGISTRY=https://registry.npmmirror.com
ARG VITE_PRODUCT_NAME=JiuwenSwarm
ENV NPM_CONFIG_REGISTRY=${NPM_REGISTRY} \
    VITE_PRODUCT_NAME=${VITE_PRODUCT_NAME}

WORKDIR /build/applications/manager/manager_web
COPY applications/manager/manager_web/package.json \
     applications/manager/manager_web/package-lock.json ./
RUN npm install

COPY applications/manager/manager_web/ ./
RUN npm run build

# ---------- 阶段2:nginx 运行 ----------
FROM ${NGINX_IMAGE}

# 基础镜像以 USER 101 收尾,构建期切 root 执行 apk
USER root

# [安全加固] 强制升级 Alpine 系统依赖，消除 Node 基础镜像中的老旧系统库 CVE 漏洞
# [网络修复] 官方 dl-cdn.alpinelinux.org 在 CI 环境拉取 APKINDEX 会返回 BAD archive，切换为华为云镜像源
RUN sed -i 's|https://dl-cdn.alpinelinux.org|https://repo.huaweicloud.com|g' /etc/apk/repositories \
    && apk update && apk upgrade --no-cache && \
    apk add --no-cache bash

COPY docker/manager-web.nginx.conf.template /etc/nginx/templates/default.conf.template
COPY --from=web-builder /build/applications/manager/manager_web/dist \
     /app/agent-runtime/applications/manager/manager_web/dist

# 镜像 User 配置保持 root:OCP 由 SCC 强制随机 UID,该配置不生效;
# 保留 root 使基于本镜像的补丁二次构建可直接 RUN apk,无需 USER 指令;
# 非 root 加固由目录属主 101:0(g+w)与 /tmp 路径承载,不依赖 User 配置
EXPOSE 5273
