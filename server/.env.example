# 数据库类型：支持 mysql、sqlite、gaussdb、opengauss
DB_TYPE=mysql

# 数据库主机地址
DB_HOST=localhost

# 数据库端口：MySQL 默认 3306，GaussDB/openGauss 默认 5432
DB_PORT=3306

# 数据库登录用户名
DB_USER=root

# 数据库登录密码
DB_PASSWORD=root

# 要连接的数据库名称
DB_NAME=jiuwen_runtime

# -----------------------------------------------------------------------------
# GaussDB/openGauss POC 验证建议值
# -----------------------------------------------------------------------------
# 使用仓库自带 scripts/run-server.sh / run-server.ps1 启动时，脚本会在 DB_TYPE=gaussdb/opengauss
# 场景下自动安装 foundation[gaussdb]；若手工安装，请额外安装 async-gaussdb>=0.30.4。
# 验证 GaussDB/openGauss POC 时，建议至少替换为以下值：
# DB_TYPE=gaussdb  # 或 opengauss
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_USER=gaussdb_user
# DB_PASSWORD=gaussdb_password
# DB_NAME=gaussdb_runtime

# 低码agent 和 agent-runtime-server 运行所在的主机IP地址
IP=127.0.0.1

# 低码agent 的容器镜像地址
LOWCODE_IMAGE=swr.cn-north-4.myhuaweicloud.com/openjiuwen/studio-lowercode-agent-amd64:8.8.8

# 部署目录：存放部署过程中产生的所有文件
DEPLOY_DIR=deploys

# 依赖包目录：存放运行低码agent需要安装的所有 .whl文件
DIST_DIR=dist

# 服务监听主机：0.0.0.0 表示允许所有网络地址访问
HOST=0.0.0.0

# 服务启动端口号
PORT=8186

# 为 uv 命令全局添加额外参数
# 解决部分内网/受限环境中 uv pip install 出现的 SSL 证书校验失败、TLS 握手异常、镜像源连接失败等问题
# 如下只是一个例子，请根据自身情况修改
UV_EXTRA_ARGS="--native-tls  --allow-insecure-host mirrors.aliyun.com -i https://mirrors.aliyun.com/pypi/simple"


# 用于配置runtime-server 启动方式配置
# 注意：收到部署请求时由 runtime-server 负责启动 Agent，其启动策略如下：
#   - DEPLOY_TYPE=subprocess：
#        runtime-server 以独立进程运行，Agent 类型由部署请求参数动态决定。默认是subprocess
#   - DEPLOY_TYPE=docker：
#        runtime-server 运行在 Docker 环境中，无论部署请求内容如何，仅启动容器版 Agent
#   - DEPLOY_TYPE=k8s：
#        runtime-server 运行在 Kubernetes 集群中，无论部署请求内容如何，仅启动 K8s 编排版 Agent
DEPLOY_TYPE=subprocess


# 运行模式（仅在 DEPLOY_TYPE=subprocess 时生效，决定依赖加载来源）
# 可选值：dev | product
#   - dev： 适用于本地源码部署
#   - product：默认值，适用于从 PyPI 官方仓库安装后运行的生产环境
MODE=dev

KUBECONFIG=/path/to/kubeconfig.yaml
K8S_DEFAULT_CONFIG_PATH=/path/to/k8s_deploy_default_config.json