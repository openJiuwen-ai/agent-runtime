DEMO_ENVIRONMENT=server
DEMO_SERVICE_LABEL=simple-capabilities-demo
DEMO_REDIS_MODE=real
DEMO_REDIS_DEFAULT_TTL_SECONDS=300
DEMO_KUBERNETES_MODE=real
DEMO_KUBERNETES_NAMESPACE=simple-capabilities-demo
DEMO_KUBERNETES_POD_IMAGE=registry.example.com/simple-capabilities/pod-demo:1.0.0

OPENJIUWEN_SERVICE_DB_TYPE=mysql
OPENJIUWEN_SERVICE_DB_HOST=127.0.0.1
OPENJIUWEN_SERVICE_DB_PORT=3306
OPENJIUWEN_SERVICE_DB_NAME=simple_capabilities_demo
OPENJIUWEN_SERVICE_DB_USER=simple_capabilities_demo
OPENJIUWEN_SERVICE_DB_PASSWORD=change-me

OPENJIUWEN_SERVICE_REDIS_URL=redis://127.0.0.1:6379/0
OPENJIUWEN_SERVICE_REDIS_KEY_PREFIX=simple-capabilities-demo

OPENJIUWEN_SERVICE_LOCK_BACKEND=redis
OPENJIUWEN_SERVICE_CACHE_BACKEND=memory
OPENJIUWEN_SERVICE_DEPLOY_REPLICAS=1
OPENJIUWEN_SERVICE_REQUEST_TIMEOUT_SECONDS=30
