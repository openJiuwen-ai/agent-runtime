# =============================================================================
# ir_execution_service 本地环境变量说明
# 复制本文件为 .env 后按需填写；含密钥请勿提交到公共仓库。
# =============================================================================

# -----------------------------------------------------------------------------
# openjiuwen 工作流检查点（建议先看）
# -----------------------------------------------------------------------------
# FORCE_DEL_WORKFLOW_STATE：对应 SDK 内配置键 _force_del_workflow_state；设为 true 时，若同一
# conversation_id 下已有持久化 workflow 状态，且本次请求为「普通 dict 入参」（非交互续跑），则会在
# 执行前删除旧图/工作流检查点，相当于从头跑。对「__interactive_reply 续跑」仍走恢复逻辑，一般不受影响。
# 需避免：在依赖异常已落盘状态后、仍希望用普通输入直接顶掉续跑场景区分业务时，请结合产品评估是否开启。
FORCE_DEL_WORKFLOW_STATE=false

# -----------------------------------------------------------------------------
# 一、应用基础与代码沙箱
# -----------------------------------------------------------------------------
# DEBUG：是否开启调试类日志或行为，一般生产环境为 false。
DEBUG=false

# -----------------------------------------------------------------------------
# 运行时依赖（openjiuwen_runtime.foundation Settings 必填）
# -----------------------------------------------------------------------------
# 说明：部分代码会 import openjiuwen_runtime.foundation，
# 其 Settings 在 import 阶段就会读取一批字段；因此即使“只跑 IR/工作流、不启 Docker”，
# 也建议给齐下面两个变量（可用占位值），避免 import 时因缺字段直接失败：
# - IP：给部署/对外 URL 拼接用；本机调试用 127.0.0.1 即可
# - LOWCODE_IMAGE：给 Docker/镜像选择用；不启相关能力时填占位即可
IP=127.0.0.1
LOWCODE_IMAGE=dummy/lowcode:local

# CODE_SANDBOX_URL：代码类工作流节点（以及同类“远程执行代码”能力）的 HTTP 执行端点，启动时必填；
# 不跑代码节点也建议填一个可达占位地址，或确保工作流中不存在代码节点。
CODE_SANDBOX_URL=http://127.0.0.1:8188/run


# -----------------------------------------------------------------------------
# 二、按模型服务地址区分的 API Key（LLM_KEY__ 前缀）
# -----------------------------------------------------------------------------
# 说明：当工作流/画布节点里某 LLM 的 base_url 命中时，可改为从环境变量取 key：
#   环境变量名 = "LLM_KEY__" + 由 base_url 派生的后缀
# 后缀由主机名+路径等规则生成（大写、非字母数字变下划线）。
# 这样可以用“按网关分 key”的方式管理，而不把 key 写死在导出的 JSON 里。
# 注意：仅使用 DEFAULT_LLM_* 走默认大模型时，一般仍需要 DEFAULT_LLM_API_KEY（或能推导到 LLM_KEY__*）至少一处有效。
LLM_KEY__DASHSCOPE_ALIYUNCS_COM_COMPATIBLE_MODE_V1= # 需加密

# -----------------------------------------------------------------------------
# 三、默认大模型（记忆引擎 LongTermMemory 与部分补齐逻辑会使用）
# -----------------------------------------------------------------------------
# DEFAULT_LLM_API_BASE：OpenAI 兼容接口的 Base URL，末尾一般带 /v1。
# DEFAULT_LLM_MODEL_PROVIDER：客户端类型标识，常见为 OpenAI（兼容多种网关）。
# DEFAULT_LLM_MODEL_NAME：实际调用的模型名，需与网关支持的名称一致。
# DEFAULT_LLM_API_KEY：上述地址对应的密钥；若留空，部分场景会尝试用 LLM_KEY__* 按 base_url 推导。
# 简单理解：DEFAULT_LLM_API_KEY 是“默认大模型”的主 key；LLM_KEY__* 是“按不同 base_url 分 key”的补充机制。
DEFAULT_LLM_API_BASE="https://dashscope.aliyuncs.com/compatible-mode/v1"
DEFAULT_LLM_MODEL_PROVIDER="OpenAI"
DEFAULT_LLM_MODEL_NAME="qwen3-max"
DEFAULT_LLM_API_KEY=  # 需加密


# -----------------------------------------------------------------------------
# 四、访问大模型 HTTPS 是否校验证书
# -----------------------------------------------------------------------------
# LLM_SSL_VERIFY：false 时关闭 SSL 证书校验，内网或自签证书时可开；公网生产建议 true。
LLM_SSL_VERIFY=false

# RESTFUL_SSL_VERIFY / RESTFUL_SSL_CERT：工作流里 HTTP 服务插件（openjiuwen RestfulApi）使用，与 LLM_SSL_* 无关。
# RESTFUL_SSL_VERIFY=true 表示校验 HTTPS 证书；若目标站点证书链在运行环境不可信，可能失败（常见为自签/内网 CA）。
# 与 LLM 侧类似：公网/生产建议 true；本地调试可临时 false。
# RESTFUL_SSL_CERT 可填额外信任证书（PEM 等，具体以运行时代码/客户端要求为准），用于解决“系统不信任该 CA”的问题。
RESTFUL_SSL_VERIFY=false
# RESTFUL_SSL_CERT=


# -----------------------------------------------------------------------------
# 五、记忆引擎（LongTermMemory）行为与作用域
# -----------------------------------------------------------------------------
# MEMORY_SCOPE_ID：本应用记忆数据的逻辑隔离 ID，多实例或多人共用同一向量库时勿重复。
# MEMORY_INPUT_MSG_MAX_LEN：写入记忆的单条用户消息最大字符长度，过大可能被截断。
# MEMORY_SINGLE_TURN_HISTORY_SUMMARY_MAX_TOKEN：单轮摘要等场景允许的最大 token 上限（具体截断策略以实现为准）。
MEMORY_SCOPE_ID=ir_agent_runner_memory
MEMORY_INPUT_MSG_MAX_LEN=8192
MEMORY_SINGLE_TURN_HISTORY_SUMMARY_MAX_TOKEN=128


# -----------------------------------------------------------------------------
# 六、向量 Embedding（记忆检索、向量化写入）
# -----------------------------------------------------------------------------
# EMBED_MODEL_NAME：嵌入模型名称，需与 EMBED_BASE_URL 所在服务支持的列表一致。
# EMBED_BASE_URL：嵌入接口完整 URL，一般为某网关的 embeddings 路径。
# EMBED_API_KEY：调用嵌入服务的密钥。
# EMBEDDING_SSL_VERIFY：访问嵌入服务时是否校验 HTTPS 证书。
EMBED_MODEL_NAME=text-embedding-v3
EMBED_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/embeddings
EMBED_API_KEY=  # 需加密
EMBEDDING_SSL_VERIFY=false


# -----------------------------------------------------------------------------
# 七、向量数据库类型（记忆向量存哪里）
# -----------------------------------------------------------------------------
# INDEX_MANAGER_TYPE：填 milvus 或 chroma。只选其一；与下面 Milvus 或 Chroma 小节配套填写。
INDEX_MANAGER_TYPE=milvus


# -----------------------------------------------------------------------------
# 八、Chroma 向量库（仅当 INDEX_MANAGER_TYPE=chroma）
# -----------------------------------------------------------------------------
# MEMORY_DATA_PATH：Chroma 持久化目录，相对路径相对进程当前工作目录，不存在时部分环境会自动创建。
MEMORY_DATA_PATH=openjiuwen_runtime/memory-data


# -----------------------------------------------------------------------------
# 九、Milvus 向量库（仅当 INDEX_MANAGER_TYPE=milvus）
# -----------------------------------------------------------------------------
# MILVUS_HOST / MILVUS_PORT：Milvus 服务地址与 gRPC 端口，默认 19530。
# MILVUS_USER / MILVUS_PASSWORD：若 Milvus 开启鉴权则填写，否则可保留默认。
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_USER=root
MILVUS_PASSWORD=123456  # 需加密


# -----------------------------------------------------------------------------
# 十、业务关系型数据库（与 openjiuwen_studio.ops.config.Settings 同名）
# -----------------------------------------------------------------------------
# DB_TYPE：选择数据库类型；不同取值只会启用对应小节中的配置，其它小节的值可忽略。
# 可选：sqlite、mysql、gaussdb、opengauss
DB_TYPE=mysql


# -----------------------------------------------------------------------------
# 十一、SQLite（仅当 DB_TYPE=sqlite）
# -----------------------------------------------------------------------------
# SQLITE_DB_PATH：存放 sqlite 文件的目录。
# OPS_SQLITE_DB / AGENT_SQLITE_DB：Studio 运维库与 Agent 库文件名（本应用 memory 等用 AGENT_SQLITE_DB 对应文件）。
SQLITE_DB_PATH=openjiuwen_runtime/data/databases
OPS_SQLITE_DB=ops.db
AGENT_SQLITE_DB=openjiuwen_runtime.db


# -----------------------------------------------------------------------------
# 十二、MySQL（仅当 DB_TYPE=mysql）
# -----------------------------------------------------------------------------
# DB_HOST / DB_PORT / DB_USER / DB_PASSWORD：MySQL 连接四元组（与 Studio 一致）。
# OPS_DB_NAME / AGENT_DB_NAME：两个“逻辑库名/Schema”用途不同：
#   - OPS_DB_NAME：偏运维/管理面数据
#   - AGENT_DB_NAME：偏 Agent/运行面数据（记忆等常落在这套库上）
# 它们都是“库名（database/schema）”，不是表名，也不是 URL 路径片段。
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=123456  # 需加密
# DB_NAME：MySQL 场景下建议与 AGENT_DB_NAME 保持一致（部分 foundation 校验/默认连接会依赖 DB_NAME 字段存在）。
DB_NAME=openjiuwen_runtime
OPS_DB_NAME=openjiuwen_ops
AGENT_DB_NAME=openjiuwen_runtime


# -----------------------------------------------------------------------------
# 十二点一、GaussDB/openGauss（仅当 DB_TYPE=gaussdb 或 opengauss）
# -----------------------------------------------------------------------------
# 与 MySQL 小节复用同一套：DB_HOST / DB_PORT / DB_USER / DB_PASSWORD / OPS_DB_NAME / AGENT_DB_NAME。
# 需要额外安装异步驱动：async-gaussdb>=0.30.4（或你们内部约定的 gaussdb extra 安装方式）。
# 常见默认端口：5432（以你的实例为准）。
# 下面示例是注释，部署时把值换成真实信息：
# DB_TYPE=gaussdb  # 或 opengauss
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_USER=gaussdb_user
# DB_PASSWORD=gaussdb_password
# OPS_DB_NAME=gaussdb_runtime
# AGENT_DB_NAME=gaussdb_runtime


# -----------------------------------------------------------------------------
# 十三、KV 存储（记忆引擎中间状态等）
# -----------------------------------------------------------------------------
# KV_STORE_TYPE：
#   - redis：多进程/多实例共享（生产常用）
#   - inmemory：仅当前进程内存（适合本地、单测；重启丢数据）
#   - db：走关系型数据库的异步连接（与 DB_TYPE 等配置相关；需确保 DB 已正确配置且驱动可用）
KV_STORE_TYPE=redis


# -----------------------------------------------------------------------------
# 十四、Redis（KV_STORE_TYPE=redis 或 Checkpointer 共用连接信息时）
# -----------------------------------------------------------------------------
# 连接信息优先级（记忆引擎 KV 侧，具体以实现为准，但一般遵循“显式 URL 优先”）：
#   1) REDIS_URL（最完整，适合 TLS/哨兵/集群等）
#   2) 用 REDIS_HOST/REDIS_PORT/REDIS_USERNAME/REDIS_PASSWORD/REDIS_DB 组装
# REDIS_HOST / REDIS_PORT：单机 Redis 的 host:port；本机 6379 被占用时可改映射端口（如 6380）。
# REDIS_USERNAME：Redis 6+ ACL 用户名；无 ACL/老版本通常不需要。
# REDIS_PASSWORD：密码；无密码可留空。
# REDIS_DB：逻辑库编号 0–15（默认 0）。
# REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_USERNAME=default
REDIS_PASSWORD=123456  # 需加密
REDIS_DB=0


# -----------------------------------------------------------------------------
# 十五、工作流 / Agent 会话 Checkpointer（Redis 持久化图状态，可选）
# -----------------------------------------------------------------------------
# 用于把 LangGraph/工作流运行态在 Redis 中落地（多机续跑/断点等能力，取决于你启用的图执行路径）。
# 连接信息优先级（实现侧常见逻辑）：
#   1) CHECKPOINTER_REDIS_URL
#   2) REDIS_URL
#   3) 用 REDIS_* 组装
# CHECKPOINTER_REDIS_URL=
# CHECKPOINTER_DISABLED：设为 1 或 true 则关闭自定义 Redis checkpointer，使用 SDK 默认（多为内存）。
# CHECKPOINTER_DEFAULT_TTL_MINUTES：状态过期分钟数，0 表示不启用 TTL/不过期（以实现为准）。
# CHECKPOINTER_REFRESH_TTL_ON_READ：读时是否续期/刷新过期时间（以实现为准）。

# CHECKPOINTER_DISABLED=1
# CHECKPOINTER_DEFAULT_TTL_MINUTES=0
# CHECKPOINTER_REFRESH_TTL_ON_READ=0


# -----------------------------------------------------------------------------
# Workflow 对话上下文（SessionModelContext）持久化到 Redis（多机/跨请求续问）
# -----------------------------------------------------------------------------
# 说明：用于把 SessionModelContext（工作流/提问器等对话上下文）持久化到 Redis，支持跨请求续问。
# - 使用同一套 Redis 连接信息（见上面的 Redis 小节）；
# - key 增加业务前缀，避免与其他业务/其他服务冲突；
# - 何时落盘/何时清理，以实现为准（一般续问场景会更依赖该持久化）。
#
# LOWCODE_CONTEXT_REDIS_KEY_PREFIX：Redis key 前缀，默认明确表示 workflow 对话上下文。
# LOWCODE_CONTEXT_REDIS_TTL_SECONDS：对话上下文状态 TTL（秒），每次保存会刷新 TTL。
# LOWCODE_CONTEXT_REDIS_LOCK_TTL_SECONDS：分布式锁 TTL（秒），避免同一会话并发请求互相覆盖。
LOWCODE_CONTEXT_REDIS_KEY_PREFIX=lowcode:workflow_context
LOWCODE_CONTEXT_REDIS_TTL_SECONDS=3600
LOWCODE_CONTEXT_REDIS_LOCK_TTL_SECONDS=120


# -----------------------------------------------------------------------------
# 十六、敏感配置加密（openjiuwen_studio SecurityUtils，与 Studio 一致）
# -----------------------------------------------------------------------------
# 根密钥配好后，下列“业务敏感项”可写成密文：DB_PASSWORD、REDIS_PASSWORD、MILVUS_TOKEN、MILVUS_PASSWORD、
# DEFAULT_LLM_API_KEY、LLM_KEY__*、EMBED_API_KEY、OBS_ACCESS_KEY_ID、OBS_SECRET_ACCESS_KEY 等；IR/DSL 内密文 api_key 也同理。
# 根密钥未配置时，上述值按普通明文处理。
# 更细的加解密链路与密文格式以 Studio/SecurityUtils 实现为准（此处不展开）。

# SERVICE_MODE：
#   - develop：更偏本地/联调，允许用 SERVER_AES_MASTER_KEY 等便于落地的方式
#   - product：更偏生产注入（以你们公司的发布规范为准）
# HUAWEICLOUD_KMS_ENABLED：
#   - true：走华为云 KMS 解密链（需补齐后面 HUAWEICLOUD_* / HUAWEICLOUD_KMS_* 等变量）
#   - false：本地/进程内 AES 根密钥（SERVER_AES_*）模式
SERVICE_MODE=develop
HUAWEICLOUD_KMS_ENABLED=false

# SERVER_AES_MASTER_KEY：非 KMS 时为 32 字节随机密钥的 Base64；KMS 时为 KMS 加密后的根密钥密文（UTF-8 字符串，见 SecurityUtils._init_kms）。
# SERVER_AES_MASTER_KEY_ENV：生产建议只注入此项；develop 下可与 SERVER_AES_MASTER_KEY 二选一或并存。
SERVER_AES_MASTER_KEY=
SERVER_AES_MASTER_KEY_ENV=

# 以下为 HUAWEICLOUD_KMS_ENABLED=true 时 SecurityUtils._init_kms 与 huaweicloud_kms 会读取的变量（关闭 KMS 时可留空）。
# HUAWEICLOUD_USERNAME、HUAWEICLOUD_PASSWORD：IAM 用户名与密码，必填。
# HUAWEICLOUD_DOMAIN_NAME：租户域名，可选，IAM 默认常用 Default。
# HUAWEICLOUD_PROJECT_NAME 与 HUAWEICLOUD_PROJECT_ID：至少填其一；仅填项目名称时会请求 IAM 解析 project_id。
# HUAWEICLOUD_IAM_ENDPOINT：可选，默认 https://iam.myhuaweicloud.com
HUAWEICLOUD_USERNAME=
HUAWEICLOUD_PASSWORD=
HUAWEICLOUD_DOMAIN_NAME=
HUAWEICLOUD_PROJECT_NAME=
HUAWEICLOUD_PROJECT_ID=
HUAWEICLOUD_IAM_ENDPOINT=

# HUAWEICLOUD_REGION：KMS 区域，SecurityUtils 默认 cn-north-4。
# HUAWEICLOUD_KMS_ENDPOINT：可选，未设时默认 https://kms.{HUAWEICLOUD_REGION}.myhuaweicloud.com
# HUAWEICLOUD_KMS_KEY_ID：KMS 数据密钥 ID，解密根密钥时必填。
# HUAWEICLOUD_KMS_ENCRYPTION_ALGORITHM：可选，HuaweiCloudKMS 默认 RSAES_OAEP_SHA_256
HUAWEICLOUD_REGION=cn-north-4
HUAWEICLOUD_KMS_ENDPOINT=
HUAWEICLOUD_KMS_KEY_ID=
HUAWEICLOUD_KMS_ENCRYPTION_ALGORITHM=


# -----------------------------------------------------------------------------
# 十七、华为云 OBS（与 openjiuwen AioBotoClient 一致；需 aioboto3 等）
# -----------------------------------------------------------------------------
# 以下六项启动时均必填：HTTP 请求里 ir_path 为桶内对象键，文件缓存到 LOWCODE_IR_DOWNLOAD_DIR。
# 本地联调可把测试 JSON 预先放到 LOWCODE_IR_DOWNLOAD_DIR 下与 ir_path 相对路径一致，则不会发起 OBS 下载；OBS 相关变量可填占位非空值以满足启动校验。
# OBS_ACCESS_KEY_ID / OBS_SECRET_ACCESS_KEY：访问密钥。
# OBS_SERVER：终端节点 URL，例如 https://obs.cn-north-4.myhuaweicloud.com，须与桶所在区域一致。
# OBS_REGION：区域代号，例如 cn-north-4。
# LOWCODE_IR_OBS_BUCKET：桶名。
# LOWCODE_IR_DOWNLOAD_DIR：本机缓存根目录，可相对路径。
# LOWCODE_IR_CACHE_MAX_FILES：缓存目录下（递归）普通文件数量上限，超过则按修改时间删掉最旧的一半；0 表示不限制；默认 100。
# LOWCODE_IR_FETCH_LOCK_TIMEOUT_S：同一缓存文件下载互斥锁等待超时（秒），默认 300。
OBS_ACCESS_KEY_ID=  # 需加密
OBS_SECRET_ACCESS_KEY=  # 需加密
OBS_SERVER=
OBS_REGION=
LOWCODE_IR_OBS_BUCKET=
LOWCODE_IR_DOWNLOAD_DIR=.lowcode_ir_cache
LOWCODE_IR_CACHE_MAX_FILES=100
LOWCODE_IR_FETCH_LOCK_TIMEOUT_S=300
