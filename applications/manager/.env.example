# Manager 管理面环境变量示例
# 复制为同目录下的 `.env` 后按需修改：
#   cp applications/manager/.env.example applications/manager/.env
#
# 加载约定：
# - identity_center / manager_server：只读本目录 .env（进程环境变量优先于文件）
# - manager_web（Vite）：envDir 指向本目录，读取 VITE_* 变量

# =============================================================================
# 前端展示 / Vite（manager_web）
# =============================================================================
# 产品主展示名（侧栏品牌、登录标题、浏览器 title 等），默认 JiuwenSwarm
VITE_PRODUCT_NAME=JiuwenSwarm
# API / 身份中心基址（一般走同源反代，本地开发可保持默认）
# VITE_API_BASE=/api
# VITE_IDP_BASE=/idp

# =============================================================================
# 身份中心 identity-center（默认端口 8770）
# =============================================================================
IDENTITY_REST_HOST=0.0.0.0
IDENTITY_REST_PORT=8770

# 数据库类型：sqlite | mysql | postgresql（postgresql 亦可写 postgres / pg）
IDENTITY_DB_TYPE=sqlite
IDENTITY_SQLITE_PATH=identity.db
# MySQL / PostgreSQL 时使用：
# IDENTITY_DB_HOST=127.0.0.1
# IDENTITY_DB_PORT=3306
# IDENTITY_DB_USER=root
# IDENTITY_DB_PASSWORD=root
# IDENTITY_DB_NAME=identity

IDENTITY_JWT_ISSUER=openjiuwen-identity
IDENTITY_JWT_AUDIENCE=openjiuwen
IDENTITY_ACCESS_TTL=1800
IDENTITY_REFRESH_TTL=604800

# 首次启动是否播种本地开发账号（admin/admin、user1/user1）
IDENTITY_SEED_ADMIN=true
IDENTITY_SEED_USER1=true

# 联合认证 Demo Provider（仅用于本地/集成链路验证，默认关闭）
# 统一从 Manager Web 的 /idp 同源入口访问时，PUBLIC_PATH_PREFIX 保持 /idp。
IDENTITY_FEDERATION_DEMO_ENABLED=false
IDENTITY_FEDERATION_PUBLIC_PATH_PREFIX=/idp
IDENTITY_FEDERATION_REQUEST_TTL=300
IDENTITY_FEDERATION_CODE_TTL=60
IDENTITY_FEDERATION_DEMO_ADMIN_GROUP=enterprise-admins

# =============================================================================
# 管理 API manager-server（REST 8765）
# =============================================================================
MANAGER_REST_HOST=0.0.0.0
MANAGER_REST_PORT=8765

# 数据库类型：sqlite | mysql | postgresql（postgresql 亦可写 postgres / pg）
MANAGER_DB_TYPE=sqlite
MANAGER_SQLITE_PATH=manager.db
# MySQL / PostgreSQL 时使用：
MANAGER_DB_HOST=127.0.0.1
MANAGER_DB_PORT=3306
MANAGER_DB_USER=root
MANAGER_DB_PASSWORD=root
MANAGER_DB_NAME=manager

MANAGER_HEARTBEAT_TIMEOUT_SECONDS=120
MANAGER_HEARTBEAT_SCAN_INTERVAL_SECONDS=60

# 验签 identity-center 签发的 JWT（issuer/audience 须与身份中心一致）
IDENTITY_PUBLIC_KEY_URL=http://127.0.0.1:8770/v1/auth/public_key
# IDENTITY_JWT_ISSUER / IDENTITY_JWT_AUDIENCE 见上方身份中心段（两侧共用同名变量）

# 本实例标识（用户态 /user-console/agents 限定当前 gateway；管理端接口一般不用）
# JIUWENCLAW_ID=

# 配置下发：字段级加密 / 加签（默认关闭）
CLAWMANAGER_CONFIG_ENC_ENABLED=false
CLAWMANAGER_CONFIG_ENC_REQUIRED=false
CLAWMANAGER_CONFIG_SIGN_ENABLED=false
CLAWMANAGER_CONFIG_SIGN_ALG=Ed25519

# 本地拉起时写入 Gateway 的数据库环境（可选）
# JIUWENCLAW_GATEWAY_DB_TYPE=mysql
# JIUWENCLAW_GATEWAY_DB_HOST=localhost
# JIUWENCLAW_GATEWAY_DB_PORT=3306
# JIUWENCLAW_GATEWAY_DB_USER=root
# JIUWENCLAW_GATEWAY_DB_PASSWORD=123456
# JIUWENCLAW_GATEWAY_DB_NAME=gateway
# 亦可使用通用别名：DB_HOST / DB_PORT / DB_USER / DB_PASSWORD / DB_NAME

# =============================================================================
# 统一 Web 入口 manager-web（默认端口 5273）
# =============================================================================
MANAGER_WEB_HOST=127.0.0.1
MANAGER_WEB_PORT=5273
MANAGER_WEB_PROXY_TARGET=http://127.0.0.1:8765
MANAGER_WEB_IDP_TARGET=http://127.0.0.1:8770
MANAGER_WEB_USER_WEB_TARGET=http://127.0.0.1:5173
MANAGER_WEB_GATEWAY_HTTP_TARGET=http://127.0.0.1:19002
MANAGER_WEB_GATEWAY_WS_TARGET=http://127.0.0.1:19000
MANAGER_WEB_LOG_LEVEL=info
