# versatile_proxy.yaml — VersatileAdapterRunner 动态路由配置示例
#
# 部署路径（默认）：/etc/edpagent/config/versatile_proxy.yaml
# 若该文件不存在，Runner 会自动从 Settings（.env / 环境变量）生成唯一的 controller 配置。
#
# 配置文件加载优先级：
#   1. VersatileAdapterRunner(config_path=...) 显式参数
#   2. 环境变量 VERSATILE_PROXY_CONFIG_PATH
#   3. 部署默认路径 /etc/edpagent/config/versatile_proxy.yaml
#   4. 当前 versatile_adapter 目录下的 versatile_proxy.yaml（便于本地开发）
#
# workflow_defaults 仅对 type: workflow 的 adapter 生效：
#   - workflow adapter 未配置的字段会从 workflow_defaults 继承
#   - workflow adapter 显式配置优先于 workflow_defaults
#   - headers_template 会浅合并，adapter 同名 header 覆盖默认值
#   - forward_header_whitelist 不合并；adapter 配置后整体覆盖默认白名单
#   - controller 通常只有一个，请在 controller adapter 内完整配置
#
# a2a_gateway_defaults 仅对 type: a2a_gateway 的 adapter 生效（同上逻辑）。
# 通过环境变量 VA_WORKFLOW_ADAPTER_TYPE 切换：
#   VA_WORKFLOW_ADAPTER_TYPE=workflow     -> _match_workflow 匹配 type: workflow
#   VA_WORKFLOW_ADAPTER_TYPE=a2a_gateway  -> _match_workflow 匹配 type: a2a_gateway（默认）
#
# adapters 列表可包含多个 adapter，运行时按 target 动态匹配：
#   - VA_WORKFLOW_ADAPTER_TYPE=workflow 时，target 含 workflow_id / intent 且匹配到 workflow 配置 -> VersatileWorkflow
#   - VA_WORKFLOW_ADAPTER_TYPE=a2a_gateway 时，target 含 workflow_id / intent 且匹配到 a2a_gateway 配置 -> VersatileA2AGateway
#   - 否则 -> VersatileController（使用第一个 type=controller 的配置）
#
# 各字段说明：
#   name                     - 适配器名称（日志标识）
#   type                     - controller / workflow / a2a_gateway
#   url_template             - URL 模板：
#                                - controller: 仅支持 {conversation_id}（project_id/agent_id 请写真实值）
#                                - workflow: 支持 {workflow_id}、{conversation_id}（project_id 请写真实值）
#                                - a2a_gateway: 支持 {a2a_gateway_base}、{agent_card_name}
#   timeout                  - HTTP 流式请求超时（秒），默认 600
#   headers_template         - 调用时注入的默认请求头
#   forward_header_whitelist - 仅转发白名单中的外部请求头（小写）；不设置则转发全部
#   workflow_result_node     - （controller/workflow 可选）SSE 流中匹配 node_type=="QA" 且
#                              node_name==此值的帧，提取 text 作为 workflow_result；
#                              A2A Gateway 模式不使用此字段（取最后 artifact）
#   workflow_id              - （仅 workflow/a2a_gateway）target 中 workflow_id 精确匹配时命中
#   intent                   - （仅 workflow/a2a_gateway）target 中 intent 匹配时命中
#   a2a_gateway_base         - （仅 a2a_gateway）网关基础地址
#   agent_card_name          - （仅 a2a_gateway）AgentCard 名称
#   token                    - （仅 a2a_gateway）鉴权 token

workflow_defaults:
  url_template: "https://versatile.example.com/v1/{project_id}/agent-manager/workflows/{workflow_id}/conversations/{conversation_id}"
  timeout: 600
  headers_template:
    Accept: "application/json, text/event-stream"
    stream: "true"
  forward_header_whitelist:
    - x-user-id
    - x-project-id
    - cust-token
    - cust-userid
    - cookie

# A2A Gateway 默认配置（VA_WORKFLOW_ADAPTER_TYPE=a2a_gateway 时生效）
a2a_gateway_defaults:
  a2a_gateway_base: "https://a2a-gateway.example.com"
  url_template: "{a2a_gateway_base}/a2a/{agent_card_name}"
  timeout: 600
  headers_template:
    Accept: "text/event-stream, application/json"
    Content-Type: "application/json"
  forward_header_whitelist:
    - x-b3-traceid
    - x-b3-spanid
    - x-b3-parentspanid
    - x-b3-sampled
    - x-biz-tag
    - x-user-id

adapters:
  - name: default_controller
    type: controller
    url_template: "https://versatile.example.com/v1/{project_id}/agents/agt_default/conversations/{conversation_id}"
    timeout: 600
    headers_template:
      Accept: "application/json, text/event-stream"
      stream: "true"
    forward_header_whitelist:
      - x-user-id
      - x-project-id
      - cust-token
      - cust-userid
      - cookie
    workflow_result_node: ""

  - name: versatile_workflow_1
    type: workflow
    intent: "knowledge_qa"
    workflow_id: "wf_abc123"
    workflow_result_node: "WorkflowQAResponseNode"

  - name: versatile_workflow_2
    type: workflow
    intent: "special_flow"
    workflow_id: "wf_special"
    url_template: "https://special.example.com/v1/{project_id}/agent-manager/workflows/{workflow_id}/conversations/{conversation_id}"
    timeout: 120
    headers_template:
      X-App-Code: "special"
    forward_header_whitelist:
      - authorization
      - x-tenant-id
    workflow_result_node: "SpecialQAResponseNode"

  # A2A Gateway 适配器（VA_WORKFLOW_ADAPTER_TYPE=a2a_gateway 时命中）
  # 公共字段继承 a2a_gateway_defaults，只需配置差异项
  - name: versatile_gateway_knowledge_qa
    type: a2a_gateway
    intent: "knowledge_qa"
    agent_card_name: "KnowledgeAgent"
    token: "workflow-knowledge-token"
