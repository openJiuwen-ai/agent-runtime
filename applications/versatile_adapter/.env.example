# ── App ──────────────────────────────────────────────────────────────────────
APP_NAME=VersatileAdapter

# ── Versatile 低码平台 ────────────────────────────────────────────────────────
# {conversation_id} 在运行时替换为实际会话 ID
VERSATILE_URL_TEMPLATE=
VERSATILE_TIMEOUT=600

# ── FastAPI ───────────────────────────────────────────────────────────────────
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8091
FASTAPI_DEBUG=False
FASTAPI_WORKERS=1

# ── Log ───────────────────────────────────────────────────────────────────────
LOG_LEVEL=DEBUG
LOG_FILE=logs/versatile_adapter.log
