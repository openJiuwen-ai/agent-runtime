# ── App ──────────────────────────────────────────────────────────────────────
ADAPTER_APP_NAME=VersatileAdapter

# ── Versatile 低码平台 ────────────────────────────────────────────────────────
# 说明：以下 VERSATILE_URL_TEMPLATE / VERSATILE_TIMEOUT /
# VERSATILE_HEADERS_TEMPLATE / VERSATILE_WORKFLOW_RESULT_NODE 等配置，
# 仅在未提供或未成功加载 /etc/edpagent/config/versatile_proxy.yaml 时，
# 用于自动生成唯一的 default_controller 兜底配置。
# 正式部署、多 adapter 路由、workflow intent/workflow_id 匹配等场景，
# 请优先使用 versatile_proxy.yaml；YAML 存在且 adapters 非空时，以 YAML 为准。
# {conversation_id} 在运行时替换为实际会话 ID
VERSATILE_URL_TEMPLATE=
# versatile请求超时时延，需要<=工小智前端超时时延57s
VERSATILE_TIMEOUT=57

# 调用 Versatile 时无条件注入的默认请求头（JSON）。默认仅含 Accept/stream；需要
# Session 鉴权（Cookie:AGENT_SID 等）的环境取消下面那行的 # 注释 + 替换 token 即可。
# Cookie token 由 VA 平台签发，必须与 VERSATILE_URL_TEMPLATE 里的 project_id 匹配，
# 否则 VA 会以 403 "URL.project_id ↔ token.project_id mismatch" 拒绝。
# ⚠️ 不要保留 ``VERSATILE_HEADERS_TEMPLATE=`` 空赋值 —— pydantic Json 字段 parse 空字符串
#    会报 ValidationError 导致 VA 启动失败。要么保留注释、要么提供合法 JSON。
# VERSATILE_HEADERS_TEMPLATE={"Cookie":"AGENT_SID=<token>","Accept":"application/json, text/event-stream","stream":"true"}

# 后端类型：controller（一级控制器）或 workflow（低码工作流）
# VERSATILE_BACKEND_TYPE=controller

# 需要屏蔽的工作流结果节点名（node_type=="QA" 且 node_name==此值的帧被提取为 workflow_result）
# VERSATILE_WORKFLOW_RESULT_NODE=GXZQAResponseNode

# ── FastAPI ───────────────────────────────────────────────────────────────────
ADAPTER_FASTAPI_HOST=0.0.0.0
ADAPTER_FASTAPI_PORT=8091
ADAPTER_FASTAPI_DEBUG=False
ADAPTER_FASTAPI_WORKERS=1

# ── Versatile 工作流最终结果节点名 ───────────
va_workflow_result_node=

# ── A2A 网关模式切换 ───────────────────────────
# a2a_gateway（默认）：走 A2A 1.0 网关协议（VersatileA2AGateway）
# workflow：直连低码工作流（VersatileWorkflow）
VA_WORKFLOW_ADAPTER_TYPE=a2a_gateway

# ── Log ───────────────────────────────────────────────────────────────────────
ADAPTER_LOG_LEVEL=DEBUG
ADAPTER_LOG_FILE=logs/versatile_adapter.log
# 日志轮转大小（loguru格式，如 "100 MB"）
ADAPTER_LOG_ROTATION_SIZE=100 MB
# 日志保留天数（0=不按天数清理，默认7天）
ADAPTER_LOG_RETENTION_DAYS=7
# 日志总空间上限（字节，0=不按空间清理，默认500MB）
ADAPTER_LOG_MAX_TOTAL_SIZE=500 MB

# ── Redis（会话状态）─────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_SESSION_TTL=180

