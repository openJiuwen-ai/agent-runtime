RUNTIME_CAPABILITIES_MODE=server
RUNTIME_CAPABILITIES_SERVICE_LABEL=runtime-capabilities-server
RUNTIME_CAPABILITIES_REDIS_DEFAULT_TTL_SECONDS=300
RUNTIME_CAPABILITIES_KUBERNETES_NAMESPACE=runtime-capabilities
RUNTIME_CAPABILITIES_KUBERNETES_POD_IMAGE=redis:7-alpine
RUNTIME_CAPABILITIES_KUBERNETES_POD_RUN_AS_USER=999
RUNTIME_CAPABILITIES_KUBERNETES_POD_RUN_AS_GROUP=1000

# Set this when the process runs outside Kubernetes and the default kubeconfig is not used.
# KUBECONFIG=/path/to/kubeconfig

OPENJIUWEN_SERVICE_HOST=0.0.0.0
OPENJIUWEN_SERVICE_PORT=8090

OPENJIUWEN_SERVICE_DB_TYPE=mysql
OPENJIUWEN_SERVICE_DB_HOST=127.0.0.1
OPENJIUWEN_SERVICE_DB_PORT=3306
OPENJIUWEN_SERVICE_DB_NAME=runtime_capabilities
OPENJIUWEN_SERVICE_DB_USER=root
OPENJIUWEN_SERVICE_DB_PASSWORD=change-me

OPENJIUWEN_SERVICE_REDIS_URL=redis://127.0.0.1:6379/0
OPENJIUWEN_SERVICE_REDIS_KEY_PREFIX=runtime-capabilities
OPENJIUWEN_SERVICE_LOCK_BACKEND=redis
OPENJIUWEN_SERVICE_CACHE_BACKEND=memory
OPENJIUWEN_SERVICE_DEPLOY_REPLICAS=1
OPENJIUWEN_SERVICE_REQUEST_TIMEOUT_SECONDS=30
