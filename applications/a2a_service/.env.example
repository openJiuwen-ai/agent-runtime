# ── App ──────────────────────────────────────────────────────────────────────
APP_NAME=A2A Service

# ── Redis（会话状态）─────────────────────────────────────────────────────────
REDIS_HOST=
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_SESSION_TTL=180
REDIS_CHECKPOINTER_TTL_MINUTES=60

# ── VersatileAdapter（内部 A2A 服务地址）─────────────────────────────────────
VERSATILE_ADAPTER_URL=http://localhost:8091

# ── FastAPI ───────────────────────────────────────────────────────────────────
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8090
FASTAPI_DEBUG=False
FASTAPI_WORKERS=1

# ── Log ───────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=logs/a2a_service.log

# ── LLM ───────────────────────────────────────────────────────────────────────
LLM_PROVIDER=llm_OpenAI
LLM_API_BASE=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL_NAME=deepseek-chat
LLM_VERIFY_SSL=False
LLM_USER_ID=
LLM_TOKEN=

# ── DPA Agent ─────────────────────────────────────────────────────────────────
DPA_AGENT_ID=edp_agent
DPA_AGENT_NAME=EDP Agent
DPA_MAX_ITERATIONS=10

va_workflow_result_node=
