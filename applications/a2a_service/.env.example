# ── 配置项加解密────────────────
# 未设置时以下变量均为明文；设置后可将敏感值换为 script/crypto 生成的密文。
# 生成主密钥: python applications/a2a_service/script/crypto/generate_master_key.py
# 加密字符串: python applications/a2a_service/script/crypto/crypto_cli.py --encrypt "明文"
# 注意: ir_execution_service 使用的 SERVER_AES_MASTER_KEY 用于「内存加密」，与
# 本处的 AES_MASTER_KEY（配置字段加解密）用途不同，请勿混用。
AES_MASTER_KEY=

# ── App ──────────────────────────────────────────────────────────────────────
APP_NAME=A2A Service

# ── Redis（会话状态）─────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_SESSION_TTL=180
REDIS_CHECKPOINTER_TTL_MINUTES=60

# ── Bootstrap 协调（Redis 锁 + 状态协同，多实例并发启动时使用）────────────
BOOTSTRAP_COORDINATION_ENABLED=False
BOOTSTRAP_LOCK_NAME=a2a_global_bootstrap
BOOTSTRAP_LOCK_TTL_SEC=180
BOOTSTRAP_WAIT_TIMEOUT_SEC=300
BOOTSTRAP_POLL_INTERVAL_SEC=1.0

# ── Rate Limit（入口限流）─────────────────────────────────────────────────
RATE_LIMIT_MAX_REQUESTS=5
RATE_LIMIT_WINDOW_SECONDS=120
GLOBAL_RATE_LIMIT_MAX_REQUESTS=100
GLOBAL_RATE_LIMIT_WINDOW_SECONDS=30

# ── VersatileAdapter（内部 A2A 服务地址）─────────────────────────────────────
VERSATILE_ADAPTER_URL=http://localhost:8091

# ── FastAPI ───────────────────────────────────────────────────────────────────
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8090
FASTAPI_DEBUG=False
FASTAPI_WORKERS=1

# ── Log ───────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_DIR=logs

# ── LLM（上游保留字段，供其他 Agent 参考；EDPAgent 不读此组）──────────────
LLM_PROVIDER=llm_OpenAI
LLM_API_BASE=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL_NAME=deepseek-chat
LLM_VERIFY_SSL=False
LLM_USER_ID=
LLM_TOKEN=

# ── LLM（EDPAgent 实际读取，统一 PLANNING_AGENT_MODEL_* 命名）──────────────
# EDPAgent/config.py 只读这一组。与上面的 LLM_* 功能重叠时，
# PLANNING_AGENT_MODEL_* 优先；建议新部署只填这一组，LLM_* 留空。
PLANNING_AGENT_MODEL_NAME=
PLANNING_AGENT_MODEL_API_KEY=
PLANNING_AGENT_MODEL_BASE_URL=
PLANNING_AGENT_MODEL_TIMEOUT=120
SKILL_LLM_TLS_VERIFY=false

# ── 企业内网 LLM 鉴权（可选，按所用网关要求填写）──────────────────────────
# 每个鉴权字段由「值变量」和「header 名变量」组成一对，均需填写。
# ⚠️ 值变量有内容时，对应的 header 名变量必须同时填写，否则启动报错。
#
# 示例 A — 通用网关（header 名为 token / userId）：
#   PLANNING_AGENT_MODEL_TOKEN=my-token
#   PLANNING_AGENT_MODEL_TOKEN_HEADER=token
#   PLANNING_AGENT_MODEL_USER_ID=user-001
#   PLANNING_AGENT_MODEL_USER_ID_HEADER=userId
#
# 示例 B — 银行网关（X-Bank-Token / X-User-Id，附加渠道号）：
#   PLANNING_AGENT_MODEL_TOKEN=gw-token-001
#   PLANNING_AGENT_MODEL_TOKEN_HEADER=X-Bank-Token
#   PLANNING_AGENT_MODEL_USER_ID=cust-1001
#   PLANNING_AGENT_MODEL_USER_ID_HEADER=X-User-Id
#   PLANNING_AGENT_MODEL_EXTRA_HEADERS={"X-Channel-Id":"mobile-banking"}
#
PLANNING_AGENT_MODEL_TOKEN=
PLANNING_AGENT_MODEL_TOKEN_HEADER=
PLANNING_AGENT_MODEL_USER_ID=
PLANNING_AGENT_MODEL_USER_ID_HEADER=
PLANNING_AGENT_MODEL_EXTRA_HEADERS=

# ── DPA Agent ─────────────────────────────────────────────────────────────────
DPA_AGENT_ID=edp_agent
DPA_AGENT_NAME=EDP Agent
DPA_MAX_ITERATIONS=30

# ── Versatile 工作流最终结果节点名（a2a_service/config.py 读取）───────────
va_workflow_result_node=

# ── 沙箱配置 ──
# 沙箱服务地址
SANDBOX_URL=
# skill 在沙箱中的存储位置。
SKILL_TARGET_PATH=/tmp

# MCP相关配置信息

# 鉴权Token信息
MCP_ACCESS_TOKEN=
# MCP名称
MCP_APP_NAME=
# MCP地址
MCP_MASTER_URL=
# MCP备用地址
MCP_STANDBY_URL=
# MCP超时
MCP_TIMEOUT=
