# ── 配置项加解密────────────────
# 未设置时以下变量均为明文；设置后可将敏感值换为 script/crypto 生成的密文。
# 注意: ir_execution_service 使用的 SERVER_AES_MASTER_KEY 用于「内存加密」，与
# 本处的 AES_MASTER_KEY（配置字段加解密）用途不同，请勿混用。
AES_MASTER_KEY=

# ── App ──────────────────────────────────────────────────────────────────────
APP_NAME=A2A Service

# ── Redis（会话状态）─────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_SESSION_TTL=180
REDIS_CHECKPOINTER_TTL_MINUTES=60

# ── Bootstrap 协调（Redis 锁 + 状态协同，多实例并发启动时使用）────────────
BOOTSTRAP_COORDINATION_ENABLED=False
BOOTSTRAP_LOCK_NAME=a2a_global_bootstrap
BOOTSTRAP_LOCK_TTL_SEC=180
BOOTSTRAP_WAIT_TIMEOUT_SEC=300
BOOTSTRAP_POLL_INTERVAL_SEC=1.0

# ── Rate Limit（入口限流），需要根据模型实际并发能力配置────────────────────────────────────────
RATE_LIMIT_MAX_REQUESTS=5
RATE_LIMIT_WINDOW_SECONDS=120
GLOBAL_RATE_LIMIT_MAX_REQUESTS=100
GLOBAL_RATE_LIMIT_WINDOW_SECONDS=30

# ── VersatileAdapter（内部 A2A 服务地址）─────────────────────────────────────
VERSATILE_ADAPTER_URL=http://localhost:8091
# a2a_service → VersatileAdapter 的 HTTP 超时（秒），与versatile_adapter中VERSATILE_TIMEOUT 默认值对齐，需要<=工小智前端超时时延57s
VERSATILE_ADAPTER_TIMEOUT=57

# ── Runtime Heartbeat ───────────────────────────────────────────────────────
HEARTBEAT_INTERVAL_SECONDS=15
HEARTBEAT_TIMEOUT_SECONDS=1800

# ── 并行子 Agent / 多工作流（对齐 TECH §5.1）─────────────────────────────────
# 注：子 Agent url 不再由框架配置（P-006）——由 Agent 自管、随派发请求下传，框架不读取。
MAX_CONCURRENT_SUB_AGENTS=3
SUB_AGENT_TIMEOUT_SECONDS=1800
MAX_PARALLEL_WORKFLOWS_PER_AGENT=3
WORKFLOW_TIMEOUT_SECONDS=900
MAX_CALL_DEPTH=3

# ── FastAPI ───────────────────────────────────────────────────────────────────
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8090
FASTAPI_DEBUG=False
FASTAPI_WORKERS=1

# ── Log ───────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_DIR=logs
# 日志轮转大小（loguru格式，如 "20 MB"）
LOG_ROTATION_SIZE=20 MB
# 日志保留天数（0=不按天数清理，默认7天）
LOG_RETENTION_DAYS=7
# 日志总空间上限（支持 "500 MB"/"1GB" 格式，0=不按空间清理，默认500MB）
LOG_MAX_TOTAL_SIZE=500 MB

# ── SDK 日志（openjiuwen SDK 的日志清理配置）────────────────────────────
# SDK 日志归档文件保留数量（轮转后最多保留 N 个 .gz，默认20）
JIUWEN_LOG_BACKUP_COUNT=20
# SDK 日志单文件大小阈值（MB，达到即触发轮转，默认20MB）
JIUWEN_LOG_MAX_BYTES=20 MB
# SDK 日志归档保留天数（0=不按天数清理，默认7天）
JIUWEN_LOG_RETENTION_DAYS=7
# SDK 日志总空间上限（MB，0=不按空间清理，默认500MB）
JIUWEN_LOG_MAX_TOTAL_SIZE=500 MB

# ── LLM（上游保留字段，供其他 Agent 参考；EDPAgent 不读此组）──────────────
LLM_PROVIDER=llm_OpenAI
LLM_API_BASE=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL_NAME=deepseek-chat
LLM_VERIFY_SSL=False
LLM_USER_ID=
LLM_TOKEN=

# ── LLM（EDPAgent 实际读取，统一 PLANNING_AGENT_MODEL_* 命名）──────────────
# EDPAgent/config.py 只读这一组。与上面的 LLM_* 功能重叠时，
# PLANNING_AGENT_MODEL_* 优先；建议新部署只填这一组，LLM_* 留空。
PLANNING_AGENT_MODEL_NAME=
PLANNING_AGENT_MODEL_API_KEY=
PLANNING_AGENT_MODEL_BASE_URL=
PLANNING_AGENT_MODEL_TIMEOUT=120
SKILL_LLM_TLS_VERIFY=false

# ── 企业内网 LLM 鉴权（可选，按所用网关要求填写）──────────────────────────
# 每个鉴权字段由「值变量」和「header 名变量」组成一对，均需填写。
# ⚠️ 值变量有内容时，对应的 header 名变量必须同时填写，否则启动报错。
#
# 示例 A — 通用网关（header 名为 token / userId）：
#   PLANNING_AGENT_MODEL_TOKEN=my-token
#   PLANNING_AGENT_MODEL_TOKEN_HEADER=token
#   PLANNING_AGENT_MODEL_USER_ID=user-001
#   PLANNING_AGENT_MODEL_USER_ID_HEADER=userId
#
# 示例 B — 银行网关（X-Bank-Token / X-User-Id，附加渠道号）：
#   PLANNING_AGENT_MODEL_TOKEN=gw-token-001
#   PLANNING_AGENT_MODEL_TOKEN_HEADER=X-Bank-Token
#   PLANNING_AGENT_MODEL_USER_ID=cust-1001
#   PLANNING_AGENT_MODEL_USER_ID_HEADER=X-User-Id
#   PLANNING_AGENT_MODEL_EXTRA_HEADERS={"X-Channel-Id":"mobile-banking"}
#
PLANNING_AGENT_MODEL_TOKEN=
PLANNING_AGENT_MODEL_TOKEN_HEADER=
PLANNING_AGENT_MODEL_USER_ID=
PLANNING_AGENT_MODEL_USER_ID_HEADER=
PLANNING_AGENT_MODEL_EXTRA_HEADERS=

# ── DPA Agent ─────────────────────────────────────────────────────────────────
DPA_AGENT_ID=edp_agent
DPA_AGENT_NAME=EDP Agent
DPA_MAX_ITERATIONS=30

# ── 沙箱配置 ──
# 沙箱服务地址
SANDBOX_URL=
# skill 在沙箱中的存储位置。
SKILL_TARGET_PATH=/tmp

# MCP相关配置信息

# 鉴权Token信息
MCP_ACCESS_TOKEN=
# MCP名称
MCP_APP_NAME=
# MCP地址
MCP_MASTER_URL=
# MCP备用地址
MCP_STANDBY_URL=
# MCP超时
MCP_TIMEOUT=

# ── 记忆和上下文功能使能开关 ──────────────────────────────────────────────────────────
DPA_MEMORY_ENABLED=false
DPA_MEMORY_ENABLE_USER_PROFILE=false
DPA_MEMORY_ENABLE_SEMANTIC_MEMORY=false
DPA_MEMORY_ENABLE_EPISODIC_MEMORY=false
DPA_MEMORY_ENABLE_SUMMARY_MEMORY=false
DPA_MEMORY_VARIABLES_JSON=[{"name":"communication_style","description":"用户偏好的沟通风格"},{"name":"risk_tolerance","description":"用户风险承受偏好"},{"name":"investment_goal","description":"用户当前投资目标"}]

# ── Context Engine（滑动窗口）──────────────────────────────────────────────
DPA_CONTEXT_ENGINE_ENABLED=false
DPA_CONTEXT_ENGINE_MAX_CONTEXT_MESSAGE_NUM=200
DPA_CONTEXT_ENGINE_DEFAULT_WINDOW_ROUND_NUM=10
DPA_CONTEXT_ENGINE_ENABLE_RELOAD=false

# ── Context Compression（DialogueCompressor）──────────────────────────────
DPA_DIALOGUE_COMPRESSION_ENABLED=false
DPA_DIALOGUE_COMPRESSION_TOKENS_THRESHOLD=10000
DPA_DIALOGUE_COMPRESSION_TARGET_TOKENS=1500
DPA_DIALOGUE_COMPRESSION_KEEP_LAST_ROUND=false

# ── DPA Memory ──────────────────────────────────────────────────────────────
DPA_MEMORY_IDLE_FLUSH_TIMEOUT_SECOND=30
DPA_MEMORY_PENDING_FLUSH_CHARS_THRESHOLD=20000

# GAUSS（结构化记忆 ）
DPA_MEMORY_GAUSS_HOST=
DPA_MEMORY_GAUSS_PORT=8000
DPA_MEMORY_GAUSS_USER=root
DPA_MEMORY_GAUSS_PASSWORD=
DPA_MEMORY_GAUSS_DATABASE=postgres

# Redis（KV记忆 共用系统redis）

# ELASTICSEARCH（向量记忆）
DPA_MEMORY_ELASTICSEARCH_HOST=
DPA_MEMORY_ELASTICSEARCH_USER=""
DPA_MEMORY_ELASTICSEARCH_PASSWORD=""

# Embedding
DPA_MEMORY_EMBEDDING_MODEL_NAME=Qwen/Qwen3-Embedding-8B
DPA_MEMORY_EMBEDDING_API_BASE=http://xxxxx/v1/embeddings
DPA_MEMORY_EMBEDDING_API_KEY=sk-xxxxxx
NO_PROXY=
no_proxy=

# Embedding 鉴权（可选）
DPA_MEMORY_EMBEDDING_TOKEN=
DPA_MEMORY_EMBEDDING_TOKEN_HEADER=
DPA_MEMORY_EMBEDDING_USER_ID=
DPA_MEMORY_EMBEDDING_USER_ID_HEADER=
DPA_MEMORY_EMBEDDING_EXTRA_HEADERS=

# Memory LLM
DPA_MEMORY_LLM_PROVIDER=OpenAI
DPA_MEMORY_LLM_API_BASE=http://xxxxx:4000/v1
DPA_MEMORY_LLM_API_KEY=sk-xxxxx
DPA_MEMORY_LLM_MODEL_NAME=qwen3-next
DPA_MEMORY_LLM_VERIFY_SSL=false
DPA_MEMORY_LLM_TIMEOUT_SECOND=600

# Memory LLM 鉴权（可选）
DPA_MEMORY_LLM_TOKEN=
DPA_MEMORY_LLM_TOKEN_HEADER=
DPA_MEMORY_LLM_USER_ID=
DPA_MEMORY_LLM_USER_ID_HEADER=
DPA_MEMORY_LLM_EXTRA_HEADERS=



# ═══════════════════════════════════════════════════════════════════════════
# Phase3 改造：场景配置与 Skill 注册
# ═══════════════════════════════════════════════════════════════════════════

# ── 场景激活配置────────────────────────────────────────────────────────────
# 通过此环境变量激活指定的业务场景
# 取值范围：
#   - AgentRule_Wealth_purchase：理财购买场景
# 注意：此处填写的是文件名（不含扩展名）
ACTIVE_SCENARIO=AgentRule_Wealth_purchase

# ── Skill 注册模式配置────────────────────────────────────────────────────────
# 控制 Skill 注册行为
# 取值范围：
#   - filtered：按场景配置只注册相关 Skill（默认，推荐）
#   - all：注册所有 Skill（向后兼容模式，开发调试时使用）
DPA_SKILL_REGISTRATION_MODE=filtered

# ── Runtime DB（DB 持久化开关）────────────────────────────────────────────
# true=启用DB持久化（先写DB再写Redis，Redis miss时回源DB）；false=纯Redis模式（不开启redis数据持久化机制）
RUNTIME_DB_ENABLED=false
RUNTIME_DB_TYPE=gaussdb
RUNTIME_DB_HOST=127.0.0.1
RUNTIME_DB_PORT=8000
RUNTIME_DB_NAME=postgres
RUNTIME_DB_USER=root
RUNTIME_DB_PASSWORD=