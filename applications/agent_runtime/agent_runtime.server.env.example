# agent-runtime 部署环境（真 Redis + MySQL + K8s）
AGENT_RUNTIME_MODE=server

OPENJIUWEN_SERVICE_HOST=0.0.0.0
OPENJIUWEN_SERVICE_PORT=8091
# Redis 必须开 AOF/RDB 持久化（部署硬要求，见 HLD §7.6）
OPENJIUWEN_SERVICE_REDIS_URL=redis://127.0.0.1:6379/0
OPENJIUWEN_SERVICE_REQUEST_TIMEOUT_SECONDS=70

# DB：MySQL（配置面 service_config_template / routing_rule 表）
OPENJIUWEN_SERVICE_DB_TYPE=mysql
OPENJIUWEN_SERVICE_DB_HOST=127.0.0.1
OPENJIUWEN_SERVICE_DB_PORT=3306
OPENJIUWEN_SERVICE_DB_NAME=agent_runtime
OPENJIUWEN_SERVICE_DB_USER=agent_runtime
OPENJIUWEN_SERVICE_DB_PASSWORD=changeme

# K8s：留空则用集群内 ServiceAccount；开发机可指向 kubeconfig 路径
AGENT_RUNTIME_KUBECONFIG=

# AgentServer Pod 默认命名空间（template 可按 scope 覆盖）
AGENT_RUNTIME_DEFAULT_NAMESPACE=default
