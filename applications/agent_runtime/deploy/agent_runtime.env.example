# agent-runtime K8s 部署渲染变量（render_and_apply.sh source 本文件，
# 替换模板 <<VAR>>）。复制为 agent_runtime.env 后按环境修改。

# ---- 基本形态 ----
# 服务与 AgentServer 同 ns 部署(agent-runtime-e2e);如需分开改回,注意 RBAC 两份与 NodePort 冲突
NAMESPACE=agent-runtime-e2e
AGENT_RUNTIME_NAME=agent-runtime
# 多副本数：只改这里（Deployment.spec.replicas）。
# 红线：OPENJIUWEN_SERVICE_DEPLOY_REPLICAS 必须保持 1（模板已固定，勿加）。
AGENT_RUNTIME_REPLICAS=2

# ---- 镜像（SWR 路径约定与 5o 工具一致）----
AGENT_RUNTIME_IMAGE=swr.cn-north-4.myhuaweicloud.com/openjiuwen/jiuwenclaw-agent-runtime-amd64:0.0.1

# ---- 依赖中间件（集群内 ClusterIP Service DNS）----
AGENT_RUNTIME_REDIS_HOST=redis.default.svc.cluster.local
AGENT_RUNTIME_REDIS_PORT=6379
# Redis DB 编号建议独立（选主/编排键与其它使用方隔离）
AGENT_RUNTIME_REDIS_DB=2
# Redis Cluster 部署:不用上面三件,改模板里 OPENJIUWEN_SERVICE_REDIS_URL 直连串
# redis+cluster://<任一种子节点>:6379(TLS 用 rediss+cluster://)——cluster 只有
# db 0,不能带库号;键前缀已 hash tag 同槽化,见 docs/feature/2026-08-redis-cluster.md
# DB:mysql | postgresql(连接参数随类型;PG 端口默认 5432 可省,显式给亦可)
AGENT_RUNTIME_DB_TYPE=mysql
AGENT_RUNTIME_DB_HOST=mysql-nodeport.default.svc.cluster.local
AGENT_RUNTIME_DB_PORT=3306
AGENT_RUNTIME_DB_NAME=agent_runtime
AGENT_RUNTIME_DB_USER=agent_runtime
AGENT_RUNTIME_DB_PASSWORD=change-me

# ---- 服务参数 ----
AGENT_RUNTIME_REQUEST_TIMEOUT=300
# 等待队列超时（秒）——须显著小于模板 session_ttl（默认 8,与
# .env.production.local 一致;曾因漏设走默认 30s 与 ttl=30 碰撞出混合结果）
AGENT_RUNTIME_SCOPE_FULL_TIMEOUT=8
AGENT_RUNTIME_LOG_LEVEL=INFO
# stdout 主形态：关闭容器内文件 handler（模板已固定注入 "disabled"，勿改回）。
# 日志采集走 stdout（K8s/平台侧）；DEBUG 级别解锁 lua eval/k8s 调用耗时等明细
# OPENJIUWEN_RUNTIME_LOG_FILE=disabled
# AgentServer Pod 拉起的目标 namespace（RM 的 CRUD 面）
AGENT_RUNTIME_AGENTSERVER_NAMESPACE=agent-runtime-e2e

# ---- 资源配额 ----
AGENT_RUNTIME_CPU_REQUEST=250m
AGENT_RUNTIME_CPU_LIMIT=1
AGENT_RUNTIME_MEMORY_REQUEST=512Mi
AGENT_RUNTIME_MEMORY_LIMIT=1Gi

# ---- NodePort（可选，--nodeport 时渲染；30000-32767 内避让已占端口）----
AGENT_RUNTIME_NODE_PORT=30091
