# AgentServer HTTP/SSE 入口
AGENT_SERVER_HOST=0.0.0.0
AGENT_HTTP_ENABLED=true
AGENT_HTTP_HOST=0.0.0.0
AGENT_HTTP_PORT=8766

# 基础配置
TZ=<<TIMEZONE>>
ROLE=agentserver
HOME=<<SWARM_HOME>>
LOG_ROOT_PATH=<<SWARM_HOME>>
DB_CONNECT_TIMEOUT=<<DB_CONNECT_TIMEOUT>>
JIUWENSWARM_EDITION=enterprise
JIUWENSWARM_CONFIG_DIR=<<JIUWENSWARM_CONFIG_DIR>>
AGENT_SERVER_REACT_MAX_ITER=<<AGENT_SERVER_REACT_MAX_ITER>>
JIUWENBOX_URL=http://127.0.0.1:<<JIUWENBOX_PORT>>
# 沙箱可插拔开关
SANDBOX_TYPE=<<SANDBOX_TYPE>>

# 企业版工具黑名单（覆盖 config.yaml 中 react.disabled_tools 的 ${DISABLED_TOOLS-...}）
DISABLED_TOOLS=search_skill,install_skill,uninstall_skill,code,web_search,fetch_webpage,skill_acceleration_exec,deepresearch_execute,deepresearch_stream,deepresearch_prepare_rewrite,deepresearch_commit_rewrite,deepresearch_generate_rewrite_html,wiki_ingest,wiki_query,wiki_lint,memory_search,audio_transcription,audio_question_answering,prepare_skill_evolution,evolve_review_task,evolve_skill_experiences,list_skill_experiences,read_skill_experiences,simplify_skill_experiences,get_current_goal,submit_goal_report

# 扩展包搜索目录（企业版 agentserver 技能源等扩展）
EXTENSION_DIRS=<<SWARM_POD_CODE_PATH>>/packages/jiuwenswarm-ee/agentserver/extensions
# 自定义模型客户端源码文件名（不含 .py，多个用逗号分隔）
AGENT_EXTRA_MODEL_CLIENTS=<<AGENT_EXTRA_MODEL_CLIENTS>>
# pod 内代码路径（与 gateway 对齐，便于排查时核对 EXTENSION_DIRS 渲染结果）
SWARM_POD_CODE_PATH=<<SWARM_POD_CODE_PATH>>

# 数据库信息
GATEWAY_DB_TYPE=<<DB_TYPE>>
GATEWAY_DB_HOST=<<DB_HOST>>
GATEWAY_DB_PORT=<<DB_PORT>>
GATEWAY_DB_USER=<<GATEWAY_DB_USER>>
GATEWAY_DB_NAME=<<GATEWAY_DB_NAME>>
GATEWAY_PG_SCHEMA=<<GATEWAY_PG_SCHEMA>>
CHECKPOINT_DB_TYPE=<<DB_TYPE>>


# 日志
LLM_SSL_VERIFY=False
LOG_MASK_ENABLED=<<LOG_MASK_ENABLED>>
LOG_TO_FILE_ENABLED=true
# 用户空间配额（写盘门禁 / 命令工具 rail）；与 Manager/Gateway 共用
WORKSPACE_QUOTA_ENABLED=<<WORKSPACE_QUOTA_ENABLED>>

# 对象存储（与 deploy/.env OBS_* 对齐；企业下载 put / Gateway materialize 共用）
# OBS_URL 为空时由 runtime_handler 填内置 MinIO headless 地址
OBS_URL=<<OBS_URL>>
OBS_BUCKET=<<OBS_BUCKET>>
OBS_ACCESS_KEY=<<OBS_ACCESS_KEY>>
OBS_SECURE=<<OBS_SECURE>>
JIUWENSWARM_SSL_VERIFY=<<JIUWENSWARM_SSL_VERIFY>>
OBS_PUBLIC_BASE_URL=<<OBS_PUBLIC_BASE_URL>>
OBS_REGION=<<OBS_REGION>>

# 审计日志 OTEL（第二版：部署 env / telemetry，非 Manager 下发）
OTEL_ENABLED=<<OTEL_ENABLED>>
OTEL_EXPORTER_OTLP_ENDPOINT=<<OTEL_EXPORTER_OTLP_ENDPOINT>>
OTEL_EXPORTER_OTLP_PROTOCOL=http
OTEL_EXPORTER_TYPE=otlp
OTEL_TRACES_EXPORTER=none
OTEL_METRICS_EXPORTER=none
OTEL_LOGS_EXPORTER=otlp
OTEL_SERVICE_NAME=<<AGENT_SERVER_NAME>>

DEFAULT_HEADERS=<<DEFAULT_HEADERS>>

# [PERF] 性能开关(轻量化/扫描TTL/early写关闭;实现默认关,部署侧显式开启)
SKILL_REFRESH_TTL_SECONDS=30

# [LIFECYCLE] Box 沙箱空闲 reaper 周期(秒):稳态沙箱数 ≈ 创建速率 × TTL,
# 须与 Box 内存容量匹配(≈14.4MB/个);update_conf 生成 sandbox.idle_ttl_seconds
JIUWENBOX_IDLE_TTL_SECONDS=180
JIUWENBOX_IDLE_CHECK_INTERVAL_SECONDS=60

# [LIFECYCLE] session-scoped adapter 空闲逐出 TTL(秒,代码默认 7200)
JIUWENSWARM_SESSION_ADAPTER_IDLE_TTL_SEC=180

# [LIFECYCLE] 周期内存回收间隔(秒,代码默认 0=关):gc.collect+malloc_trim
# 收走会话循环垃圾,抑制 RSS 高水位单调爬升(实现 swarm mem_reclaimer)
JIUWENSWARM_GC_RECLAIM_INTERVAL=60

# [MEMORY] glibc 并发 arena 上限:多线程进程默认 8×核数 个 arena,各自持有
# 散碎空闲块,RSS 高水位棘轮(实测 52→28MB/h);2 即主堆+1 备援,免代价
MALLOC_ARENA_MAX=2
JIUWENSWARM_SESSION_CREATE_PREWARM=0
