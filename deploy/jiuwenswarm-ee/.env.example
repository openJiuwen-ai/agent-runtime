# 部署目标 namespace
NAMESPACE=jiuwenswarm

# 集群形态：openshift（默认）| k8s；k8s 形态的专属配置见文末
CLUSTER_TYPE=openshift

# 目标集群 API Server（openshift 形态必填），如 https://api.example.openshiftapps.com:6443
# 留空时自动探测：oc whoami --show-server > kubeconfig 当前上下文
# k8s 形态走 kubeconfig 认证，留空即可
CLUSTER_API_SERVER=

# openshift 形态 curl 是否 -k（自签/内网 CA 不在信任库保持 true 默认；false 须系统 CA 可验）
CLUSTER_API_INSECURE=true

# ====================== 存储（仅 CLUSTER_TYPE=openshift 生效） ======================
# 数据库等块存储 PVC 的 StorageClass，留空使用集群默认
DATA_STORAGE_CLASS=

# 共享工作区 PVC（ReadWriteMany）的 StorageClass，留空使用集群默认
WORKSPACE_STORAGE_CLASS=

# ====================== manager-web DNS resolver ======================
# nginx 变量 proxy_pass 所需；留空=按集群形态自动解析（openshift 用 OCP CoreDNS 服务名，
# k8s 经 kubectl/resolv.conf 取 ClusterIP），设置有值=直接使用该 IP 或服务名
MANAGER_WEB_RESOLVER=

# ====================== 凭据（启动基础服务时配置） ======================
# 安全提示：默认值为演示口令，对外可达环境请务必修改；
# 数据库 root 密码仅首次初始化生效，已初始化实例改密需同步 ALTER USER
MARIADB_ROOT_PASSWORD=
MYSQL_ROOT_PASSWORD=
POSTGRES_PASSWORD=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
REDIS_USER=
REDIS_PASSWORD=

# ====================== Redis 服务 ======================
# Redis 部署形态: standalone(单机) | cluster(集群)
# 内置 Redis 仅支持 standalone；cluster 用于对接外挂 Redis 集群（连接 URL 前缀 redis+cluster://）
REDIS_MODE=standalone

# 外部 Redis 服务的连接地址
# 留空时，自动使用本工具内置部署的 Redis（redis.<NAMESPACE>）
REDIS_HOST=

# 数据服务的连接端口
# 留空时取默认 6379；外部 Redis 填写对应端口
REDIS_PORT=

# Redis 键前缀（选配；gateway / agentserver / manager-server 的 Redis 键统一加上该前缀），
# 多套环境共享同一 Redis 实例时用于键隔离
REDIS_KEY_PREFIX=jiuwenswarm:

# ====================== 数据库服务（gateway / agentserver / identity / manager-server 共用） ======================
# 数据库类型：mariadb（默认）| mysql | postgresql，决定内置部署的数据库与连接驱动
DB_TYPE=mariadb

# 外部数据库服务的连接地址
# 留空时，自动使用本工具内置部署的数据库服务（*-headless.<NAMESPACE>）
DB_HOST=

# 数据服务的连接端口
# 留空时按 DB_TYPE 取默认（mariadb/mysql=3306，postgresql=5432）；外部数据库填写对应端口
DB_PORT=

# 数据库连接用户
# 留空时按 DB_TYPE 取默认（mariadb/mysql=root，postgresql=postgres）；外部数据库填写对应用户
DB_USER=

# 外部数据库的统一密码
# 外部数据库（DB_HOST 已填写）时必填；内置数据库忽略本变量，密码由 DB_TYPE 对应的
# MARIADB_ROOT_PASSWORD / MYSQL_ROOT_PASSWORD / POSTGRES_PASSWORD 派生
DB_PASSWORD=

# ====================== 分库配置 ======================
# 当 DB_TYPE 配置为 mysql/mariadb 时，未设置的时候，默认值为 <module>_<NAMESPACE>，以此实现多实例隔离
# 当 DB_TYPE 配置为 postgresql 时，未设置的时候，默认值为 <module>
# 设置时，则优先使用用户配置，覆盖默认规则
GATEWAY_DB_NAME=              # Gateway网关服务数据库名
WEB_DB_NAME=                  # 企业Web会话、历史存储数据库名
RUNTIME_DB_NAME=              # Agent Runtime运行时服务数据库名
IDENTITY_DB_NAME=             # Identity认证服务数据库名
MANAGER_DB_NAME=              # Manager管理服务数据库名

# 仅当 DB_TYPE 配置为 postgresql，如下配置才生效
# 未设置时，默认值为 <NAMESPACE>，以此实现多实例隔离
# 设置时，则优先使用用户配置，覆盖默认规则
GATEWAY_PG_SCHEMA=            # Gateway网关模块使用的PG schema
WEB_PG_SCHEMA=                # Web会话模块使用的PG schema
RUNTIME_PG_SCHEMA=            # Agent Runtime运行时模块使用的PG schema
IDENTITY_PG_SCHEMA=           # Identity认证模块使用的PG schema
MANAGER_PG_SCHEMA=            # Manager管理模块使用的PG schema

# 支持分库独立账号配置：分别定义 <MODULE>_DB_USER / <MODULE>_DB_PASSWORD
# 支持全局统一账号配置：统一定义 DB_USER / DB_PASSWORD
# 优先级规则：若两类变量同时配置，以分库专属账号为准，全局统一账号自动失效
# 未设置任何账号时：内置数据库使用 root/postgres + 对应 ROOT_PASSWORD；
#                   外部数据库继承 DB_USER / DB_PASSWORD
GATEWAY_DB_USER=
GATEWAY_DB_PASSWORD=
WEB_DB_USER=
WEB_DB_PASSWORD=
RUNTIME_DB_USER=
RUNTIME_DB_PASSWORD=
IDENTITY_DB_USER=
IDENTITY_DB_PASSWORD=
MANAGER_DB_USER=
MANAGER_DB_PASSWORD=

# User backend reads Manager DB views using a dedicated account.
# Empty values use built-in defaults; Manager initializes the account and view grants.
WEB_SERVER_DB_USER=
WEB_SERVER_DB_PASSWORD=

# ====================== OBS 对象存储 ======================
# 外部对象存储(S3/MinIO兼容)接入地址
# 留空时，自动使用本工具内置部署的 MinIO 实例（地址 minio.<NAMESPACE>:9000）
OBS_URL=

# 业务存储桶名称
# 使用内置 MinIO 时无需配置（默认 jiuwenswarm）；对接外部 OBS/MinIO 服务必须填写
OBS_BUCKET=jiuwenswarm

# 对象存储公网预览访问域名
# 仅文件需要浏览器公网直读场景配置，内网环境可不填
OBS_PUBLIC_BASE_URL=

# 对象存储访问的 AccessKey
# 内置 MinIO：留空自动取 MinIO 的用户账号（MINIO_ROOT_USER）；外部 OBS：填写兼容 S3 服务的 AccessKey
OBS_ACCESS_KEY=

# 对象存储访问的 SecretKey
# 内置 MinIO：留空自动取 MinIO 的用户密码（MINIO_ROOT_PASSWORD）；外部 OBS：填写兼容 S3 服务的 SecretKey
OBS_SECRET_KEY=

# 客户端连接是否启用 HTTPS
# 内置 MinIO：无需配置（固定 false）；外部 OBS：根据服务端 SSL 开关选择 true/false，留空默认 false
OBS_SECURE=

# 对象存储区域标识
# 内置 MinIO：无需配置；外部 OBS：按需填写，留空默认 default
OBS_REGION=

# 技能上传包保留天数：manager 与 AgentServer 必须配置同值
# 默认 7，最小 1，非法值回落 7；不设上限
SKILL_UPLOAD_RETENTION_DAYS=7


# 管理面「导入默认配置」数据源：渲染完成的 agentserver.json 由部署工具注入 ConfigMap
# （jiuwenswarm-manager-runtime-defaults）并只读挂载进 manager-server，无独立配置项；
# runtime 未部署时管理面提示暂无默认配置

# ====================== 跨组件共用配置 ======================
# 以下参数由部署工具同时注入多个业务组件（Manager / Gateway / AgentServer 等），
# 不属于任一单服务私有配置。

# 用户空间配额特性开关（企业版默认开启；仅 JIUWENSWARM_EDITION=enterprise 生效）
# true：管理面配额策略/用量/扩容、运行时写盘门禁、用户面工作空间页与申请页均启用
# false：上述能力关闭；工作空间、申请的导航与页面隐藏
# 前端：注入到 User Web / Manager Web 的 window.__WORKSPACE_QUOTA_ENABLED__（改后重启对应 Web 即可）
WORKSPACE_QUOTA_ENABLED=true


# ====================== agent-runtime（三模式部署形态） ======================
# 会话路由能力的启用方式，决定 agent-runtime 组件是否部署、AgentServer 如何交付：
#   full    —— agent-runtime 齐全模式：按需创建/销毁/扩缩 AgentServer 并做会话粘性路由。
#              AgentServer 不预启动（由 runtime 拉起），部署工具自动注入 Pod 操作 RBAC
#   routing —— 仅路由模式：AgentServer 预启动（StatefulSet，副本数 AGENT_SERVER_REPLICAS），
#              agent-runtime 只做会话粘性路由，实例经部署阶段 HTTP 注册进实例池；
#              零 K8s 权限即可运行（受限 OpenShift 环境推荐）
#   off     —— 不部署 agent-runtime（组件不存在），gateway 经 AGENT_SERVER_URL 直连
#              AgentServer（预启动单副本，无粘性需求）
# 默认 full。gateway 的路由客户端（GATEWAY_AGENT_CLIENT_MODE/路由地址）由部署工具
# 按模式自动派生注入，无需手工配置。
AGENT_RUNTIME_DEPLOY_MODE=full

# 禁 EVAL 兼容：Redis 禁用 EVAL 命令的环境（如客户公用 Redis）设 off；
# on 与历史行为逐字节一致
AGENT_RUNTIME_REDIS_LUA=off


# ====================== 沙箱类型（AgentServer 沙箱 Pod 隔离形态） ======================
# off       —— 保持原样：不注入沙箱运行时，AgentServer 以普通容器 Pod 运行
# jiuwenbox —— jiuwenbox 沙箱 sidecar：AgentServer Pod 注入 jiuwenbox 容器
#              （off/routing 模式的 StatefulSet 与 full 模式 config_sync 载荷均注入）。
#              仅 CLUSTER_TYPE=k8s 支持；openshift 集群暂不支持（部署工具直接拦截）
# kata      —— Kata Containers 轻量虚机沙箱：AgentServer 沙箱 Pod 注入
#              runtimeClassName: kata（off/routing 模式的 StatefulSet 与 full 模式
#              config_sync 载荷均注入）。前置条件：集群各节点已安装 Kata Containers、
#              containerd 已注册 kata 运行时且已创建 RuntimeClass kata，
#              否则沙箱 Pod 无法启动（Pending/RunContainerError）
SANDBOX_TYPE=off

# ====================== 预置 Skill / 远程 ZIP 下载域名白名单 ======================
# 注入 agentserver-env ConfigMap；留空=不注入，走 AgentServer 代码内置默认
# 逗号分隔，支持通配（如 *.obs.*.myhuaweicloud.com）与后缀（如 .example.com）
# URL 方式预置 Skill 的 package_url 主机须命中其一
IMPORT_LOCAL_ALLOWED_DOWNLOAD_HOSTS=
TEAM_SKILLS_HUB_ALLOWED_DOWNLOAD_HOSTS=

# ====================== TeamSkills Hub 基址 ===============
# 注入 gateway-env、agentserver-env、manager-server；留空=不注入，
# 走代码默认 https://swarmskills.openjiuwen.com
TEAM_SKILLS_HUB_BASE_URL=

# ====================== 主 Agent ReAct 轮次上限 ======================
# 不写或留空：ConfigMap 不注入 AGENT_SERVER_REACT_MAX_ITER，
# 生成配置不写 react.max_iterations，与个人版一样不限制。
# 正整数：主 Agent 一次调用里「调模型并执行该回复里的全部工具」的上限。
# AGENT_SERVER_REACT_MAX_ITER=100
# ====================== 用户面后端 ======================
# 用户面后端镜像由 jiuwenswarm 仓 docker/enterprise/Dockerfile.web-server 构建。
WEB_SERVER_IMAGE=""

# ====================== 用户面 Web 入口 ======================
# K8s 用户面 Web 的 NodePort，留空时自动分配。
WEB_NODE_PORT=""

# 用户面 HTTPS 证书覆盖的浏览器访问域名或 IP，多个地址用英文逗号分隔，不带协议和端口。
# K8s 自动签发时必须填写，例如 web.example.com,192.0.2.10；仅本机端口转发时填 localhost。
# OpenShift 部署会自动加入 Route 域名，仅使用该域名访问时可留空。
WEB_TLS_HOSTS=""

# 自配证书还须覆盖 <Web服务名>.<命名空间> 和 <Web服务名>.<命名空间>.svc.cluster.local。
# 在 jiuwenswarm-web-tls Secret 的 tls.crt 中包含所需中间证书，私有 CA 的公共证书放在 ca.crt 中。
# 省略 ca.crt 时，Manager 探活会使用容器内的默认信任库。

# ====================== 组件副本数 ======================
# AGENT_SERVER_REPLICAS：off 模式固定 1（配置 >1 直接报错）；routing 模式可调（粘性路由按实例分发）
# IDENTITY_REPLICAS： 建议配置为1
AGENT_SERVER_REPLICAS=1
GATEWAY_REPLICAS=1
WEB_REPLICAS=1
WEB_SERVER_REPLICAS=1
IDENTITY_REPLICAS=1
MANAGER_SERVER_REPLICAS=1
MANAGER_WEB_REPLICAS=1
AGENT_RUNTIME_REPLICAS=1


# ---------- 企业统一认证（k8s / openshift 均生效） ----------
# 启用 Agent 模板的 Keycloak 客户端注册
MANAGER_AGENT_CLIENT_REGISTRATION_ENABLED="false"
# Keycloak 客户端注册配置文件（容器内路径）
MANAGER_AGENT_CLIENT_REGISTRATION_CONFIG_FILE=""

# 以下三项需同时填写；不使用企业登录时全部留空

# 企业统一认证服务地址，填写到 /realms/<业务Realm>
# 示例：https://sso.example.com/realms/company
IDENTITY_SSO_SERVER_URL=""

# 本系统用户网页登录应用的 Client ID
IDENTITY_SSO_LOGIN_CLIENT_ID=""

# 用户 Token 的接收服务标识，对应 Token 中的 aud 字段
# 例如 egress_gateway
IDENTITY_SSO_TOKEN_AUDIENCE=""

# ---------- manager-server 程序化部署凭证 ----------
# 管理面「直接启动部署」功能用的 kubeconfig Secret 名。
# 默认开（开箱即用，默认名 manager-deploy-kubeconfig）：
#   - manager up 前置检查：目标 ns 中该 Secret 不存在时，自动从部署机当前
#     kubeconfig（$KUBECONFIG 或 ~/.kube/config）创建，键名 kubeconfig；
#     已存在则沿用不覆盖。down 不回收（凭证独立于组件生命周期）。
#   - manager-server 渲染时自动挂载对应 Secret，据此以子进程代跑 deploy.sh 部署产品面。
#   - 部署机 kubeconfig 缺失时告警放行（不阻断 up），可手工预建后重跑。
# 显式置空（MANAGER_DEPLOY_KUBECONFIG_SECRET=）禁用注入（回落 pod SA，零 RBAC）。
# 手工创建（如需自定义最小权限凭证）：
#   kubectl -n <manager-ns> create secret generic <名> --from-file=kubeconfig=<admin.conf>
MANAGER_DEPLOY_KUBECONFIG_SECRET="manager-deploy-kubeconfig"

# ---------- manager-server 程序化部署凭证（openshift 形态） ----------
# token 所在 Secret 名（键名 token）；留空用默认名 manager-deploy-token
MANAGER_DEPLOY_TOKEN_SECRET=""
MANAGER_DEPLOY_TOKEN_FILE=""

# ---------- NFS 存储数据源 ----------
# 外部 NFS 服务的服务端地址（IP）
# k8s 形态：留空=使用内置 NFS server（./deploy.sh up nfs 部署）
# openshift 形态：部署 NFS 存储供给组件（./deploy.sh up nfs）时必填（内置 NFS server 仅 k8s 形态支持）
NFS_SERVER_ADDR=""

# 外部 NFS 服务的共享根目录路径
# 使用内置 NFS server 时请勿配置，自动使用内置共享路径
NFS_SHARE_PATH=""

# ---------- NFS 存储供给组件（nfs-sc） ----------
# 基于 nfs-subdir-external-provisioner 提供标准 StorageClass，
# 业务 PVC 动态申领独立 NFS 子目录，实现数据持久化挂载
# ./deploy.sh up nfs 部署（自动解析为 nfs-sc；全集群共享，只需也只能部署一次）；openshift 形态须先填 NFS_SERVER_ADDR
# 部署 nfs-sc 时（或集群中已存在供给组件时）两变量留空会自动填充为该名称；
# 已配置视为外挂 StorageClass，工具不覆盖
NFS_SC_NAME=jiuwenswarm-storage

# ⛔⛔⛔ k8s 形态专属配置区（本行以下、直至文末「到此结束」标记）            ⛔⛔⛔
# ⛔⛔⛔ 仅 CLUSTER_TYPE=k8s 生效；openshift 形态部署时，本区变量整段不生效 ⛔⛔⛔
# ⛔⛔⛔ 新增【通用】配置严禁写入本区：请加到上方通用区                      ⛔⛔⛔

# ---------- 存储挂载模式（k8s 形态；openshift 形态无需此变量，恒为 sc 模式） ----------
# sc  = 数据卷走 PVC + StorageClass 动态供给（默认）：数据源为上方 NFS_SERVER_ADDR/NFS_SHARE_PATH，
#       搭配 NFS 存储供给组件 nfs-sc 时 DATA_STORAGE_CLASS / WORKSPACE_STORAGE_CLASS 留空自动填充，
#       也可直接指向企业已有 StorageClass
# nfs = 数据卷直连挂载 NFS（历史行为，显式选择）
MOUNT_TYPE=sc

# ---------- 内置 NFS server（k8s 形态） ----------
# ./deploy.sh up nfs 部署（须先于依赖 NFS 的组件）；固定调度到运行部署工具的节点
# NFS_HOST_PATH 为部署节点上的数据目录，默认 /data/nfs
NFS_HOST_PATH=/data/nfs

# 内置 NFS server / dev 模式的固定调度节点名；留空=按部署机 hostname/IP 自动识别
# （--render-only 离线渲染无法识别，相关清单的 nodeName 会留空并告警）
CURRENT_NODE_NAME=""

# ---------- manager-web NodePort ----------
# k8s 形态渲染时自动追加 manager-web NodePort Service，外部经 http://<节点IP>:<nodePort> 访问
# 留空=从 NODE_PORT_RANGE_START~END 自动挑选空闲端口
MANAGER_WEB_NODE_PORT=
NODE_PORT_RANGE_START=30000
NODE_PORT_RANGE_END=32767


# ---------- dev 模式：挂载宿主机代码调试 ----------
# 运行环境模式：支持 dev / product 两种值
# dev 模式：将宿主机代码目录挂载到容器内，支持代码实时修改调试
# product 模式：使用容器内置代码，不挂载宿主机目录，用于生产环境
MODE=product

# 仅在 MODE=dev 时生效：jiuwenswarm 项目在宿主机本地代码路径（请填写绝对路径）
# 不设置时，该模块目录不用挂载
SWARM_CODE_PATH=""

# 仅在 MODE=dev 时生效：agent-gateway 项目在宿主机本地代码路径（请填写绝对路径）
# 不设置时，gateway 使用镜像内置代码
GATEWAY_CODE_PATH=""

# 仅在 MODE=dev 时生效：agent-runtime 项目在宿主机本地代码路径（请填写绝对路径）
# 不设置时，该模块目录不用挂载
RUNTIME_CODE_PATH=""

# 仅在 MODE=dev 时生效：agent-core 项目在宿主机本地代码路径（请填写绝对路径）
# 不设置时，该模块目录不用挂载
CORE_CODE_PATH=""

# 是否要给 Web 模块mount代码
# 注意Web源代码代码需要如下操作之后，才能mount进容器
# cd jiuwenswarm/channels/web/frontend
# npm install                                                       # 此操作只需要一次
# npm run build                                                  # 每改一次代码后重新构建
IS_MOUNT_WEB_CODE="false"

<<<<<<< HEAD
# Gateway 服务的容器最大可用 CPU：0.5核，超出会被K8s限流
GATEWAY_CPU_LIMIT=500m

# Gateway 服务的容器最大可用 内存：1Gi，超出会被K8s强制杀死重启
GATEWAY_MEMORY_LIMIT=1Gi

# 业务应用内置日志脱敏功能开关
LOG_MASK_ENABLED=true

# 业务应用日志本地文件输出开关
# true：业务进程同时输出至标准输出 + 写入本地日志文件（容器内）
# false：业务进程仅输出日志至标准输出，想要持久化，可通过 FluentBit+Vector 采集后统一落盘到宿主机上
LOG_TO_FILE_ENABLED=true

# Gateway Pod 调度限制开关，开启后仅能调度到带有 gateway=enable 标签的节点
GATEWAY_SCHED_LABEL_ENABLED="false"

# Gateway 副本实例数量，控制部署运行的 Pod 个数
GATEWAY_REPLICAS=1


# ====================== AgentServer 配置 ======================
# AgentServer 服务镜像地址
AGENT_SERVER_IMAGE=""

# AgentServer 副本实例数量，控制部署运行的 Pod 个数（仅 AGENT_RUNTIME_ENABLED=false 时生效）
AGENT_SERVER_REPLICAS=1

#拓展配置自定义rail
AGENT_EXTRA_RAILS=""

#拓展配置自定义tool（模块需暴露 register_tools() 工厂，分号分隔多个模块路径）
AGENT_EXTRA_TOOLS=""

# 自定义模型客户端源码文件名（不含 .py，多个用逗号分隔）
# 源码放在 jiuwenswarm/extensions/model_clients；生产环境需将源码及依赖预置到镜像
AGENT_EXTRA_MODEL_CLIENTS=""

# AgentServer 服务的容器最小保证 CPU：500毫核（0.5核），K8s 必须至少分配这么多 CPU 才能启动
AGENT_SERVER_CPU_REQUEST=500m

# AgentServer 服务的容器最小保证 内存：1Gi，K8s 必须至少分配这么多内存才能启动
AGENT_SERVER_MEMORY_REQUEST=1Gi

# AgentServer 服务的容器最大可用 CPU：500毫核（0.5核），超过会被 K8s 限流
AGENT_SERVER_CPU_LIMIT=500m

# AgentServer 服务的容器最大可用 内存：1Gi，超过会被 K8s OOM kill 杀死重启
AGENT_SERVER_MEMORY_LIMIT=1Gi

# ReActAgent 的最大循环轮数上限,  即 agent "思考→调工具→再思考"这个循环最多跑多少轮。它是防止 agent 无限循环的"刹车"——达到上限后强制停止，不管任务有没有完成。否则极端情况下，LLM 一直不收敛（不停调工具），那花费的时间会非常恐怖。
AGENT_SERVER_REACT_MAX_ITER=10

# LLM 调用时附带的自定义 HTTP 头（JSON 对象字符串）
# 适用场景：LLM 网关要求额外认证/路由头（如华为 MaaS、OfficeClaw 的 authorization）
# 示例：DEFAULT_HEADERS={"authorization": "Bearer xxx"}
# 留空表示不附加
DEFAULT_HEADERS=


# ======================  JIUWENBOX 配置 ======================
# 沙箱类型：jiuwenbox（启用沙箱容器）| off（关闭沙箱，业务走 LOCAL 直跑）
SANDBOX_TYPE="jiuwenbox"

# JIUWENBOX 服务镜像地址
JIUWENBOX_IMAGE=""

# JIUWENBOX 服务的容器最小保证 CPU：500毫核（0.5核），K8s 必须至少分配这么多 CPU 才能启动
JIUWENBOX_CPU_REQUEST=500m

# JIUWENBOX 服务的容器最小保证 内存：1Gi，K8s 必须至少分配这么多内存才能启动
JIUWENBOX_MEMORY_REQUEST=1Gi

# JIUWENBOX 服务的容器最大可用 CPU：500毫核（0.5核），超过会被 K8s 限流
JIUWENBOX_CPU_LIMIT=500m

# JIUWENBOX 服务的容器最大可用 内存：1Gi，超过会被 K8s OOM kill 杀死重启
JIUWENBOX_MEMORY_LIMIT=1Gi

# Box 沙箱空闲 reaper 周期(秒)：稳态沙箱数 ≈ 创建速率 × TTL，须与 Box 内存容量
# 匹配(≈14.4MB/个)。issue#5718：高速率短会话下 600s 会在 2Gi 内累积 OOM
JIUWENBOX_IDLE_TTL_SECONDS=180
JIUWENBOX_IDLE_CHECK_INTERVAL_SECONDS=60


# ====================== 用户面后端 ======================
# 用户面后端镜像由 Swarm 的 docker/Dockerfile.user-backend 构建。
USER_BACKEND_IMAGE=""
USER_BACKEND_REPLICAS=1

# ====================== WEB 服务配置 ======================
# Web 前端模块容器镜像地址
WEB_IMAGE=""

# Web 服务对外暴露的主机端口
# 不设置就自动寻找空闲端口，如需要设置，请确保该端口的唯一性（范围: 30000-32767）
WEB_NODE_PORT=

# 用户面 HTTPS 证书覆盖的浏览器访问域名或 IP，多个地址用英文逗号分隔，不带协议和端口。
# 自动签发时，省略或留空默认使用 localhost。
# 示例：WEB_TLS_HOSTS="web.example.com,1.2.3.4"
WEB_TLS_HOSTS=""

# 自配证书还须覆盖 <Web服务名>.<命名空间> 和 <Web服务名>.<命名空间>.svc.cluster.local。
# 在 jiuwenswarm-web-tls Secret 的 tls.crt 中包含所需中间证书，私有 CA 的公共证书放在 ca.crt 中。
# 省略 ca.crt 时，Manager 探活会使用容器内的默认信任库。

# Web 副本实例数量，控制部署运行的 Pod 个数
WEB_REPLICAS=1

# 前端默认请求超时，单位：秒；不配置默认 15。重新部署 Web 并刷新页面后生效。
# 单个接口显式设置的超时优先；HTTP 聊天收到响应头后不限制后续 SSE 总时长。
WEB_REQUEST_TIMEOUT_SECONDS=15

# 企业级 Web：聊天界面工具结果展示的最大字符数（经 Gateway 注入；0 表示不截断，默认 500）
TOOL_RESULT_DISPLAY_MAX_CHARS=500

# WEB 服务的容器最小保证 CPU：500毫核（0.5核），K8s 必须至少分配这么多 CPU 才能启动
WEB_CPU_REQUEST=500m

# WEB 服务的容器最小保证 内存：1Gi，K8s 必须至少分配这么多内存才能启动
WEB_MEMORY_REQUEST=1Gi

# WEB 服务的容器最大可用 CPU：500毫核（0.5核），超过会被 K8s 限流
WEB_CPU_LIMIT=500m

# WEB 服务的容器最大可用 内存：1Gi，超过会被 K8s OOM kill 杀死重启
WEB_MEMORY_LIMIT=1Gi


# ====================== Agent Runtime 服务配置 ======================
# Agent Runtime 可插拔总开关：
#   true  -> 部署 agent-runtime 模块（默认），由 agent-runtime 负责动态创建/管理 agentserver pod
#   false -> 不部署 agent-runtime，agentserver 以 Deployment+Service 的形式部署
AGENT_RUNTIME_ENABLED=true

# Gateway 南向客户端：runtime 注册 RuntimeRoutedAgentClient；websocket 直连本机 AgentServer
GATEWAY_AGENT_CLIENT_MODE=runtime

# Agent Runtime 服务镜像地址
AGENT_RUNTIME_IMAGE=""

# Agent Runtime 副本实例数量，控制部署运行的 Pod 个数
AGENT_RUNTIME_REPLICAS=1

# Agent Runtime 监听 AgentServer Pod 事件的轮询间隔（秒），默认 10。
# 值越小感知变更越快，但 CPU/etcd 轮询开销越高。
AGENT_RUNTIME_WATCH_INTERVAL=10

# Agent Runtime 健康探测单次 HTTP 超时（秒，支持小数），默认 3.0。
# AgentServer 慢启动/高负载下 /health 响应慢于超时会被连续判失败（2 次）
# 误杀半死并排空重建，此场景调大；判死时延≈2×轮询间隔，与超时无关。
AGENT_RUNTIME_HEALTH_PROBE_TIMEOUT=3.0

# Redis 使用 Lua 模式开关
# on  - 正常模式，使用 EVAL/Lua 脚本（默认；不设置等同 on）
# off - 无 Lua 模式，状态层与框架锁改走 WATCH/MULTI/EXEC （用于 Redis 禁用 EVAL/Lua 的环境)
AGENT_RUNTIME_REDIS_LUA=on
# agent-server Pod 供给模式：full=自建/自删（默认）；routing=客户预先用
# StatefulSet 拉起 AgentServer 并调 POST /api/session/register_pods 注册，
# agent-runtime 只负责分配（路由/绑定/健康探测），不创建/删除 Pod、
# 不调用任何 K8s API（ServiceAccount 无需任何 pods 权限）。
# routing 模式要求：Pod 有 headless service 稳定域名（注册时按域名编址与
# 探测，StatefulSet 重建后自动恢复）；gateway 与 runtime 可解析该域名。
AGENT_RUNTIME_DEPLOY_MODE=full

# Agent Runtime 服务的容器最小保证 CPU：500毫核（0.5核），K8s 必须至少分配这么多 CPU 才能启动
AGENT_RUNTIME_CPU_REQUEST=500m

# Agent Runtime 服务的容器最小保证 内存：1Gi，K8s 必须至少分配这么多内存才能启动
AGENT_RUNTIME_MEMORY_REQUEST=1Gi

# Agent Runtime 服务的容器最大可用 CPU：500毫核（0.5核），超过会被 K8s 限流
AGENT_RUNTIME_CPU_LIMIT=500m

# Agent Runtime 服务的容器最大可用 内存：1Gi，超过会被 K8s OOM kill 杀死重启
AGENT_RUNTIME_MEMORY_LIMIT=1Gi


# ====================== 大模型接口配置 ======================
# 模型厂商标识（如：OpenAI等）
MODEL_PROVIDER=""

# 大模型名称
MODEL_NAME=""

# 大模型API基础地址
API_BASE=""

# 大模型鉴权密钥
API_KEY=""
