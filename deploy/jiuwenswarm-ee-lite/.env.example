# jiuwenswarm-ee-lite 本地配置样例
# 用法: 复制为项目根 .env（已被 .gitignore 忽略,不进 git）后按需取消注释。
# 真实环境变量优先于 .env;全部变量见 README「配置参考」。

# ── 用户面前端 jiuwenclaw 克隆来源（frontend build 自动克隆时使用）────────
#LITE_JIUWENCLAW_URL=https://gitcode.com/openjiuwen/jiuwenclaw.git
#LITE_JIUWENCLAW_BRANCH=develop

# ── 其它常用（均为示例,完整清单见 README「配置参考」）────────────────────
#LITE_ADMIN_PASSWORD=admin
#LITE_USER1_PASSWORD=user1
#JIUWENSWARM_EE_LITE_HOME=./data
