# 部署目标 namespace
NAMESPACE=jiuwenclaw

# 集群形态：openshift（默认）| k8s；k8s 形态的专属配置见文末
CLUSTER_TYPE=openshift

# 目标集群 API Server（openshift 形态必填），如 https://api.example.openshiftapps.com:6443
# k8s 形态走 kubeconfig 认证，留空即可
CLUSTER_API_SERVER=

# ====================== 存储（仅 CLUSTER_TYPE=openshift 生效） ======================

# 数据库等块存储 PVC 的 StorageClass，留空使用集群默认
DATA_STORAGE_CLASS=

# 共享工作区 PVC（ReadWriteMany）的 StorageClass，留空使用集群默认
WORKSPACE_STORAGE_CLASS=

# ====================== manager-web DNS resolver ======================
# nginx 变量 proxy_pass 所需；留空=按集群形态自动解析（openshift 用 OCP CoreDNS 服务名，
# k8s 经 kubectl/resolv.conf 取 ClusterIP），设置有值=直接使用该 IP 或服务名
MANAGER_WEB_RESOLVER=

# ====================== 组件副本数 ======================
# AGENT_SERVER_REPLICAS / IDENTITY_REPLICAS 建议保持 1
AGENT_SERVER_REPLICAS=1
GATEWAY_REPLICAS=1
WEB_REPLICAS=1
IDENTITY_REPLICAS=1
MANAGER_SERVER_REPLICAS=1
MANAGER_WEB_REPLICAS=1


# ====================== k8s 形态专属（仅 CLUSTER_TYPE=k8s 生效） ======================

# ---------- NFS 直连挂载 ----------
# mariadb/mysql/postgresql/minio/agentserver 的数据卷直连挂载 NFS（redis 纯缓存不挂卷，模板已关闭 AOF），
# 路径 <NFS_SHARE_PATH>/<NAMESPACE>/<组件>
# NFS_SHARE_PATH 为 NFS v4 导出根（伪根），路径相对导出根解析；
# 如服务器把 /data/nfs 配为导出根（fsid=0），此处填 /，数据实际落在服务器 /data/nfs 下
NFS_SERVER_ADDR=
NFS_SHARE_PATH=/

# ---------- manager-web NodePort ----------
# k8s 形态渲染时自动追加 manager-web NodePort Service，外部经 http://<节点IP>:<nodePort> 访问
# 留空=从 NODE_PORT_RANGE_START~END 自动挑选空闲端口
MANAGER_WEB_NODE_PORT=
NODE_PORT_RANGE_START=30000
NODE_PORT_RANGE_END=32767
# true=跳过端口占用检查（此时 MANAGER_WEB_NODE_PORT 必须显式配置）
NO_CHECK_PORTS=false

# ---------- dev 模式：挂载宿主机代码调试 ----------
# 运行环境模式：支持 dev / product 两种值
# dev 模式：将宿主机代码目录挂载到容器内，支持代码实时修改调试
# product 模式：使用容器内置代码，不挂载宿主机目录，用于生产环境
MODE=product

# 仅在 MODE=dev 时生效：jiuwenclaw 项目在宿主机本地代码路径（请填写绝对路径）
# 不设置时，该模块目录不用挂载
CLAW_CODE_PATH=""

# 仅在 MODE=dev 时生效：agent-runtime 项目在宿主机本地代码路径（请填写绝对路径）
# 不设置时，该模块目录不用挂载
RUNTIME_CODE_PATH=""

# 仅在 MODE=dev 时生效：agent-core 项目在宿主机本地代码路径（请填写绝对路径）
# 不设置时，该模块目录不用挂载
CORE_CODE_PATH=""

# 是否要给 Web 模块mount代码
# 注意Web源代码代码需要如下操作之后，才能mount进容器
# cd jiuwenswarm/channels/web/frontend
# npm install                # 此操作只需要一次
# npm run build              # 每改一次代码,就需要操作一次
IS_MOUNT_WEB_CODE="false"

# 是否要给 Manager-Web 模块mount代码
# 注意Web源代码代码需要如下操作之后，才能mount进容器
# cd agent-runtime/applications/manager/manager_web
# npm install                # 此操作只需要一次
# npm run build              # 每改一次代码,就需要操作一次
IS_MOUNT_MANAGER_WEB_CODE=false

