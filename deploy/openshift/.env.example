# 部署目标 namespace
NAMESPACE=jiuwenswarm

# 集群形态：openshift（默认）| k8s；k8s 形态的专属配置见文末
CLUSTER_TYPE=openshift

# 目标集群 API Server（openshift 形态必填），如 https://api.example.openshiftapps.com:6443
# 留空时自动探测：oc whoami --show-server > kubeconfig 当前上下文
# k8s 形态走 kubeconfig 认证，留空即可
CLUSTER_API_SERVER=

# ====================== 存储（仅 CLUSTER_TYPE=openshift 生效） ======================
# 数据库等块存储 PVC 的 StorageClass，留空使用集群默认
DATA_STORAGE_CLASS=

# 共享工作区 PVC（ReadWriteMany）的 StorageClass，留空使用集群默认
WORKSPACE_STORAGE_CLASS=

# ====================== manager-web DNS resolver ======================
# nginx 变量 proxy_pass 所需；留空=按集群形态自动解析（openshift 用 OCP CoreDNS 服务名，
# k8s 经 kubectl/resolv.conf 取 ClusterIP），设置有值=直接使用该 IP 或服务名
MANAGER_WEB_RESOLVER=

# ====================== 凭据（启动基础服务时配置） ======================
# 安全提示：默认值为演示口令，对外可达环境请务必修改；
# 数据库 root 密码仅首次初始化生效，已初始化实例改密需同步 ALTER USER
MARIADB_ROOT_PASSWORD=
MYSQL_ROOT_PASSWORD=
POSTGRES_PASSWORD=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
REDIS_USER=
REDIS_PASSWORD=

# ====================== Redis 服务 ======================
# Redis 部署形态: standalone(单机) | cluster(集群)
# 内置 Redis 仅支持 standalone；cluster 用于对接外挂 Redis 集群（连接 URL 前缀 redis+cluster://）
REDIS_MODE=standalone

# 外部 Redis 服务的连接地址
# 留空时，自动使用本工具内置部署的 Redis（redis.<NAMESPACE>）
REDIS_HOST=

# 数据服务的连接端口
# 留空时取默认 6379；外部 Redis 填写对应端口
REDIS_PORT=

# Redis 键前缀（选配；gateway / agentserver / manager-server 的 Redis 键统一加上该前缀），
# 多套环境共享同一 Redis 实例时用于键隔离
REDIS_KEY_PREFIX=jiuwenswarm:

# ====================== 数据库服务（gateway / agentserver / identity / manager-server 共用） ======================
# 数据库类型：mariadb（默认）| mysql | postgresql，决定内置部署的数据库与连接驱动
DB_TYPE=mariadb

# 外部数据库服务的连接地址
# 留空时，自动使用本工具内置部署的数据库服务（*-headless.<NAMESPACE>）
DB_HOST=

# 数据服务的连接端口
# 留空时按 DB_TYPE 取默认（mariadb/mysql=3306，postgresql=5432）；外部数据库填写对应端口
DB_PORT=

# 数据库连接用户
# 留空时按 DB_TYPE 取默认（mariadb/mysql=root，postgresql=postgres）；外部数据库填写对应用户
DB_USER=

# 外部数据库的统一密码
# 外部数据库（DB_HOST 已填写）时必填；内置数据库忽略本变量，密码由 DB_TYPE 对应的
# MARIADB_ROOT_PASSWORD / MYSQL_ROOT_PASSWORD / POSTGRES_PASSWORD 派生
DB_PASSWORD=

# ====================== 分库配置 ======================
# 当 DB_TYPE 配置为 mysql/mariadb 时，未设置的时候，默认值为 <module>_<NAMESPACE>，以此实现多实例隔离
# 当 DB_TYPE 配置为 postgresql 时，未设置的时候，默认值为 <module>
# 设置时，则优先使用用户配置，覆盖默认规则
GATEWAY_DB_NAME=              # Gateway网关服务数据库名
WEB_DB_NAME=                  # 企业Web会话、历史存储数据库名
RUNTIME_DB_NAME=              # Agent Runtime运行时服务数据库名
IDENTITY_DB_NAME=             # Identity认证服务数据库名
MANAGER_DB_NAME=              # Manager管理服务数据库名

# 仅当 DB_TYPE 配置为 postgresql，如下配置才生效
# 未设置时，默认值为 <NAMESPACE>，以此实现多实例隔离
# 设置时，则优先使用用户配置，覆盖默认规则
GATEWAY_PG_SCHEMA=            # Gateway网关模块使用的PG schema
WEB_PG_SCHEMA=                # Web会话模块使用的PG schema
RUNTIME_PG_SCHEMA=            # Agent Runtime运行时模块使用的PG schema
IDENTITY_PG_SCHEMA=           # Identity认证模块使用的PG schema
MANAGER_PG_SCHEMA=            # Manager管理模块使用的PG schema

# 支持分库独立账号配置：分别定义 <MODULE>_DB_USER / <MODULE>_DB_PASSWORD
# 支持全局统一账号配置：统一定义 DB_USER / DB_PASSWORD
# 优先级规则：若两类变量同时配置，以分库专属账号为准，全局统一账号自动失效
# 未设置任何账号时：内置数据库使用 root/postgres + 对应 ROOT_PASSWORD；
#                   外部数据库继承 DB_USER / DB_PASSWORD
GATEWAY_DB_USER=
GATEWAY_DB_PASSWORD=
WEB_DB_USER=
WEB_DB_PASSWORD=
RUNTIME_DB_USER=
RUNTIME_DB_PASSWORD=
IDENTITY_DB_USER=
IDENTITY_DB_PASSWORD=
MANAGER_DB_USER=
MANAGER_DB_PASSWORD=

# ====================== OBS 对象存储 ======================
# 外部对象存储(S3/MinIO兼容)接入地址
# 留空时，自动使用本工具内置部署的 MinIO 实例（地址 minio.<NAMESPACE>:9000）
OBS_URL=

# 业务存储桶名称
# 使用内置 MinIO 时无需配置（默认 jiuwenswarm）；对接外部 OBS/MinIO 服务必须填写
OBS_BUCKET=jiuwenswarm

# 对象存储公网预览访问域名
# 仅文件需要浏览器公网直读场景配置，内网环境可不填
OBS_PUBLIC_BASE_URL=

# 对象存储访问的 AccessKey
# 内置 MinIO：留空自动取 MinIO 的用户账号（MINIO_ROOT_USER）；外部 OBS：填写兼容 S3 服务的 AccessKey
OBS_ACCESS_KEY=

# 对象存储访问的 SecretKey
# 内置 MinIO：留空自动取 MinIO 的用户密码（MINIO_ROOT_PASSWORD）；外部 OBS：填写兼容 S3 服务的 SecretKey
OBS_SECRET_KEY=

# 客户端连接是否启用 HTTPS
# 内置 MinIO：无需配置（固定 false）；外部 OBS：根据服务端 SSL 开关选择 true/false，留空默认 false
OBS_SECURE=

# 对象存储区域标识
# 内置 MinIO：无需配置；外部 OBS：按需填写，留空默认 default
OBS_REGION=

# 技能上传包保留天数：manager 与 AgentServer 必须配置同值
# 默认 7，最小 1，非法值回落 7；不设上限
SKILL_UPLOAD_RETENTION_DAYS=7


# ====================== 跨组件共用配置 ======================
# 以下参数由部署工具同时注入多个业务组件（Manager / Gateway / AgentServer 等），
# 不属于任一单服务私有配置。

# 用户空间配额特性开关（默认关闭）
# true：管理面配额策略/用量/扩容、运行时写盘门禁、用户面工作空间页与申请页均启用
# false：上述能力关闭；工作空间、申请的导航与页面隐藏
# 前端：注入到 User Web / Manager Web 的 window.__WORKSPACE_QUOTA_ENABLED__（改后重启对应 Web 即可）
WORKSPACE_QUOTA_ENABLED=false

# 用户面选路 Cookie（jiuwenclaw_id）的 Secure 属性：auto | true | false
# auto（默认）按请求实际到达的协议决定——HTTPS 才加，HTTP NodePort 部署保持可用。
# 注意：manager-web 与 manager-server 是两个 Pod，请求跨 Pod 到达，管理面的 uvicorn 只信任
# 回环对端（127.0.0.1,::1），auto 在该拓扑下恒判 http。入口已终结 TLS 的部署请直接置 true，
# 不要依赖 auto——跨 Pod 形态下它取不到 https。
MANAGER_ACTIVE_CLUSTER_COOKIE_SECURE=auto


# ====================== agent-runtime（三模式部署形态） ======================
# 会话路由能力的启用方式，决定 agent-runtime 组件是否部署、AgentServer 如何交付：
#   full    —— agent-runtime 齐全模式：按需创建/销毁/扩缩 AgentServer 并做会话粘性路由。
#              AgentServer 不预启动（由 runtime 拉起），部署工具自动注入 Pod 操作 RBAC
#   routing —— 仅路由模式：AgentServer 预启动（StatefulSet，副本数 AGENT_SERVER_REPLICAS），
#              agent-runtime 只做会话粘性路由，实例经部署阶段 HTTP 注册进实例池；
#              零 K8s 权限即可运行（受限 OpenShift 环境推荐）
#   off     —— 不部署 agent-runtime（组件不存在），gateway 经 AGENT_SERVER_URL 直连
#              AgentServer（预启动单副本，无粘性需求）
# 默认 routing。gateway 的路由客户端（GATEWAY_AGENT_CLIENT_MODE/路由地址）由部署工具
# 按模式自动派生注入，无需手工配置。
AGENT_RUNTIME_DEPLOY_MODE=routing

# 禁 EVAL 兼容：Redis 禁用 EVAL 命令的环境（如客户公用 Redis）设 off；
# on 与历史行为逐字节一致
AGENT_RUNTIME_REDIS_LUA=off


# ====================== 沙箱类型（AgentServer 沙箱 Pod 隔离形态） ======================
# off       —— 保持原样：不注入沙箱运行时，AgentServer 以普通容器 Pod 运行
# jiuwenbox —— jiuwenbox 沙箱 sidecar：AgentServer Pod 注入 jiuwenbox 容器
#              （off/routing 模式的 StatefulSet 与 full 模式 config_sync 载荷均注入）。
#              仅 CLUSTER_TYPE=k8s 支持；openshift 集群暂不支持（部署工具直接拦截）
# kata      —— Kata Containers 轻量虚机沙箱：AgentServer 沙箱 Pod 注入
#              runtimeClassName: kata（off/routing 模式的 StatefulSet 与 full 模式
#              config_sync 载荷均注入）。前置条件：集群各节点已安装 Kata Containers、
#              containerd 已注册 kata 运行时且已创建 RuntimeClass kata，
#              否则沙箱 Pod 无法启动（Pending/RunContainerError）
SANDBOX_TYPE=off

# ====================== 预置 Skill / 远程 ZIP 下载域名白名单 ======================
# 注入 agentserver-env ConfigMap；留空=不注入，走 AgentServer 代码内置默认
# 逗号分隔，支持通配（如 *.obs.*.myhuaweicloud.com）与后缀（如 .example.com）
# URL 方式预置 Skill 的 package_url 主机须命中其一
IMPORT_LOCAL_ALLOWED_DOWNLOAD_HOSTS=
TEAM_SKILLS_HUB_ALLOWED_DOWNLOAD_HOSTS=

# ====================== 主 Agent ReAct 轮次上限 ======================
# 不写或留空：ConfigMap 不注入 AGENT_SERVER_REACT_MAX_ITER，
# 生成配置不写 react.max_iterations，与个人版一样不限制。
# 正整数：主 Agent 一次调用里「调模型并执行该回复里的全部工具」的上限。
# AGENT_SERVER_REACT_MAX_ITER=100

# ====================== 组件副本数 ======================
# AGENT_SERVER_REPLICAS：off 模式固定 1（配置 >1 直接报错）；routing 模式可调（粘性路由按实例分发）
# IDENTITY_REPLICAS： 建议配置为1
AGENT_SERVER_REPLICAS=1
GATEWAY_REPLICAS=1
WEB_REPLICAS=1
IDENTITY_REPLICAS=1
MANAGER_SERVER_REPLICAS=1
MANAGER_WEB_REPLICAS=1
AGENT_RUNTIME_REPLICAS=1


# ====================== k8s 形态专属（仅 CLUSTER_TYPE=k8s 生效） ======================

# ---------- NFS 直连挂载 ----------
# mariadb/mysql/postgresql/minio/agentserver 的数据卷直连挂载 NFS（redis 纯缓存不挂卷，模板已关闭 AOF），
# 路径 <NFS_SHARE_PATH>/<NAMESPACE>/<组件>
# NFS_SHARE_PATH 为 NFS v4 导出根（伪根），路径相对导出根解析；
# 如服务器把 /data/nfs 配为导出根（fsid=0），此处填 /，数据实际落在服务器 /data/nfs 下
# NFS_SERVER_ADDR 留空=使用内置 NFS server（地址自动解析，数据目录自动创建）；
# 填写地址=外部 NFS server（数据目录须自行创建）
NFS_SERVER_ADDR=
NFS_SHARE_PATH=/

# ---------- manager-web NodePort ----------
# k8s 形态渲染时自动追加 manager-web NodePort Service，外部经 http://<节点IP>:<nodePort> 访问
# 留空=从 NODE_PORT_RANGE_START~END 自动挑选空闲端口
MANAGER_WEB_NODE_PORT=
NODE_PORT_RANGE_START=30000
NODE_PORT_RANGE_END=32767

# ---------- 企业登录 ----------
# 启用 Agent 模板的 Keycloak 客户端注册
MANAGER_AGENT_CLIENT_REGISTRATION_ENABLED="false"
# Keycloak 客户端注册配置文件（容器内路径）
MANAGER_AGENT_CLIENT_REGISTRATION_CONFIG_FILE=""

# 以下三项需同时填写；不使用企业登录时全部留空

# 企业统一认证服务地址，填写到 /realms/<业务Realm>
# 示例：https://sso.example.com/realms/company
IDENTITY_SSO_SERVER_URL=""

# 本系统用户网页登录应用的 Client ID
IDENTITY_SSO_LOGIN_CLIENT_ID=""

# 用户 Token 的接收服务标识，对应 Token 中的 aud 字段
# 例如 egress_gateway
IDENTITY_SSO_TOKEN_AUDIENCE=""

# ---------- manager-server 程序化部署凭证 ----------
# 管理面「直接启动部署」功能用的 kubeconfig Secret 名（k8s 形态）。
# 留空=不注入（默认，行为不变）；填写后：
#   - manager up 前置检查：目标 ns 中该 Secret 不存在时，自动从部署机当前
#     kubeconfig（$KUBECONFIG 或 ~/.kube/config）创建，键名 kubeconfig；
#     已存在则沿用不覆盖。down 不回收（凭证独立于组件生命周期）。
#   - manager-server 渲染时自动挂载该 Secret（只读 subPath 到
#     /etc/manager/deploy-kubeconfig），据此以子进程代跑 deploy.sh 部署产品面。
# 手工创建（如需自定义最小权限凭证）：
#   kubectl -n <manager-ns> create secret generic <名> --from-file=kubeconfig=<admin.conf>
MANAGER_DEPLOY_KUBECONFIG_SECRET=""

# ---------- dev 模式：挂载宿主机代码调试 ----------
# 运行环境模式：支持 dev / product 两种值
# dev 模式：将宿主机代码目录挂载到容器内，支持代码实时修改调试
# product 模式：使用容器内置代码，不挂载宿主机目录，用于生产环境
MODE=product

# 仅在 MODE=dev 时生效：jiuwenswarm 项目在宿主机本地代码路径（请填写绝对路径）
# 不设置时，该模块目录不用挂载
SWARM_CODE_PATH=""

# 仅在 MODE=dev 时生效：agent-runtime 项目在宿主机本地代码路径（请填写绝对路径）
# 不设置时，该模块目录不用挂载
RUNTIME_CODE_PATH=""

# 仅在 MODE=dev 时生效：agent-core 项目在宿主机本地代码路径（请填写绝对路径）
# 不设置时，该模块目录不用挂载
CORE_CODE_PATH=""

# 是否要给 Web 模块mount代码
# 注意Web源代码代码需要如下操作之后，才能mount进容器
# cd jiuwenswarm/channels/web/frontend
# npm install                                                       # 此操作只需要一次
# VITE_BASE_PATH="./" VITE_API_PREFIX="" npm run build              # 每改一次代码,就需要操作一次
IS_MOUNT_WEB_CODE="false"

# 是否要给 Manager-Web 模块mount代码
# 注意Web源代码代码需要如下操作之后，才能mount进容器
# cd agent-runtime/applications/manager/manager_web
# npm install                # 此操作只需要一次
# npm run build              # 每改一次代码,就需要操作一次
IS_MOUNT_MANAGER_WEB_CODE=false

